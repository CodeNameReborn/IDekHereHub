local function sendWebhook(Name, RewardsText, GameTime)
    local url = _G.SST.WebHook_Url
    if not url or url == "" then
        warn("Invalid Webhook URL")
        return
    end

    local fields = {
        {
            name = "📊 Total 📊",
            value =
                "```" ..
                "Name        : " .. Name .. "\n" ..
                "Gem         : " .. tostring(player:GetAttribute("Gems")) .. "\n" ..
                "Gold        : " .. tostring(player:GetAttribute("Gold")) .. "\n" ..
                "Level       : " .. tostring(player:GetAttribute("Level")) .. "\n" ..
                "Exp         : " .. tostring(player:GetAttribute("Experience")) .. "\n" ..
                "TraitReroll : " .. tostring(player:GetAttribute("TraitRerolls")) ..
                "```"
        },
        {
            name = "⌛ Time ⌛",
            value = "```" .. GameTime .. "```"
        },
        {
            name = "🎁 Rewards 🎁",
            value = "```" .. RewardsText .. "```"
        }
    }

    local data = {
        embeds = {{
            author = { name = "IDekHere Hub WebHook" },
            title = "Anime Vanguards",
            color = 0x13da,
            thumbnail = {
                url = "https://tr.rbxcdn.com/180DAY-668ccf8ad9d6d533c554d59fe2ddbeef/420/420/Image/Png/noFilter"
            },
            image = {
                url = "https://tr.rbxcdn.com/180DAY-3b66598f56036101897a7a5eb31fe52c/768/432/Image/Webp/noFilter"
            },
            fields = fields
        }}
    }

    local request = http_request or request or syn.request
    if request then
        request({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
        print("✅ WebHook Sent for match:", Name)
    else
        warn("HTTP request function not available")
    end
end

