local Library = {}
_G.Color = Color3.fromRGB(0, 122, 255)

function Library:AddWindow(name)
    if CoreGui:FindFirstChild("macOS_Premium") then CoreGui["macOS_Premium"]:Destroy() end

    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "macOS_Premium"
    ScreenGui.ResetOnSpawn = false

    local Main = Instance.new("Frame", ScreenGui)
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 620, 0, 400)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    Main.ClipsDescendants = true
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 12)
    
    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Color = Color3.fromRGB(60, 60, 65)
    MainStroke.Thickness = 1.2

    -- Top Bar
    local Top = Instance.new("Frame", Main)
    Top.Size = UDim2.new(1, 0, 0, 40)
    Top.BackgroundTransparency = 1
    Top.ZIndex = 10

    local Title = Instance.new("TextLabel", Top)
    Title.Size = UDim2.new(1, 0, 1, 0)
    Title.Text = name
    Title.Font = Enum.Font.GothamBold
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 14
    Title.BackgroundTransparency = 1

    -- [UI State Management]
    local CurrentState = "Normal"
    local OriginalSize = UDim2.new(0, 620, 0, 400)
    local OriginalPos = UDim2.new(0.5, 0, 0.5, 0)
    local ExpandOverlay = Instance.new("TextButton", Main)
    ExpandOverlay.Size = UDim2.new(1, 0, 1, 0)
    ExpandOverlay.BackgroundTransparency = 1
    ExpandOverlay.Text = ""
    ExpandOverlay.Visible = false
    ExpandOverlay.ZIndex = 5

    local function ChangeUIState(state)
        CurrentState = state
        if state == "Normal" then
            ExpandOverlay.Visible = false
            Title.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Size = OriginalSize, Position = OriginalPos}):Play()
        elseif state == "Mini" then
            ExpandOverlay.Visible = true
            Title.Visible = false
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(0.1, 0, 0.1, 0)}):Play()
        elseif state == "Island" then
            ExpandOverlay.Visible = true
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 400, 0, 35), Position = UDim2.new(0.5, 0, 0, 20)}):Play()
        elseif state == "Full" then
            TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
        end
    end

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Enum.KeyCode.RightControl then
            ChangeUIState(CurrentState == "Normal" and "Island" or "Normal")
        end
    end)

    ExpandOverlay.MouseButton1Click:Connect(function() ChangeUIState("Normal") end)

    local function CreateLight(color, x, goal)
        local b = Instance.new("TextButton", Top)
        b.Size = UDim2.new(0, 12, 0, 12)
        b.Position = UDim2.new(0, x, 0.5, -6)
        b.BackgroundColor3 = color
        b.Text = ""
        b.ZIndex = 11
        Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
        b.MouseButton1Click:Connect(function() ChangeUIState(goal) end)
    end
    CreateLight(Color3.fromRGB(255, 95, 87), 15, "Mini")
    CreateLight(Color3.fromRGB(255, 189, 46), 35, "Island")
    CreateLight(Color3.fromRGB(40, 201, 64), 55, "Full")

    -- [Dragging]
    local dragging, dragStart, startPos
    Top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = Main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

    local Sidebar = Instance.new("Frame", Main)
    Sidebar.Size = UDim2.new(0, 160, 1, -40)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Sidebar.BorderSizePixel = 0

    local PageContainer = Instance.new("Frame", Main)
    PageContainer.Size = UDim2.new(1, -160, 1, -40)
    PageContainer.Position = UDim2.new(0, 160, 0, 40)
    PageContainer.BackgroundTransparency = 1

    local TabScroll = Instance.new("ScrollingFrame", Sidebar)
    TabScroll.Size = UDim2.new(1, 0, 1, -10)
    TabScroll.Position = UDim2.new(0, 0, 0, 5)
    TabScroll.BackgroundTransparency = 1
    TabScroll.ScrollBarThickness = 0
    local TabList = Instance.new("UIListLayout", TabScroll)
    TabList.Padding = UDim.new(0, 5)
    TabList.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local Tabs = {}
    function Tabs:AddTab(tabName)
