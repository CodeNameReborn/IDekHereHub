-- callbacks ที่ UI Settings จะเรียกตอนปรับ
local ThemeCallbacks = {}
local function onThemeChange(key, fn) ThemeCallbacks[key] = fn end
local function applyTheme(key, val)
    Theme[key] = val
    if ThemeCallbacks[key] then ThemeCallbacks[key](val) end
end

