function FeatureFlags.new()
    local self = setmetatable({}, FeatureFlags)
    
    self.flags = {}
    self.listeners = {}
    self.cache_time = 0
    self.user_id = Players.LocalPlayer.UserId
    self.user_hash = self:_hashUserId(self.user_id)
    
    for name, config in pairs(DEFAULT_FLAGS) do
        self.flags[name] = {
            enabled = config.enabled,
            config = config
        }
    end
    
    if FF_CONFIG.REMOTE_URL then
        self:fetchRemoteFlags()
    end
    
    return self
end

function FeatureFlags:isEnabled(flag_name)
    local flag = self.flags[flag_name]
    if not flag then
        self:_log("⚠️ Flag ไม่มีอยู่: " .. flag_name)
        return false
    end
    
    if flag.config.whitelist then
        local in_whitelist = table.find(flag.config.whitelist, self.user_id)
        if not in_whitelist then
            return false
        end
    end
    
    if flag.config.type == "percentage" then
        local rollout = flag.config.rollout or 0
        return self:_isInRollout(flag_name, rollout)
    end
    
    return flag.enabled
end

function FeatureFlags:getConfig(flag_name)
    local flag = self.flags[flag_name]
    return flag and flag.config or nil
end

function FeatureFlags:setFlag(flag_name, enabled)
    if not self.flags[flag_name] then
        self:_log("⚠️ ไม่สามารถตั้งค่า flag ที่ไม่มี: " .. flag_name)
        return false
    end
    
    self.flags[flag_name].enabled = enabled
    self:_notifyListeners(flag_name, enabled)
    self:_log("✅ Flag อัพเดท: " .. flag_name .. " = " .. tostring(enabled))
    
    return true
end

function FeatureFlags:onChange(flag_name, callback)
    if not self.listeners[flag_name] then
        self.listeners[flag_name] = {}
    end
    table.insert(self.listeners[flag_name], callback)
end

function FeatureFlags:getAllFlags()
    local result = {}
    for name, flag in pairs(self.flags) do
        result[name] = {
            name = name,
            enabled = self:isEnabled(name),
            description = flag.config.description,
            type = flag.config.type
        }
    end
    return result
end

function FeatureFlags:fetchRemoteFlags()
    if not FF_CONFIG.REMOTE_URL then return end
    
    local success, response = pcall(function()
        return HttpService:GetAsync(FF_CONFIG.REMOTE_URL .. "?user=" .. self.user_id)
    end)
    
    if success then
        local data = HttpService:JSONDecode(response)
        for name, value in pairs(data) do
            if self.flags[name] then
                self.flags[name].enabled = value
            end
        end
        self:_log("✅ โหลด Remote Flags สำเร็จ")
    else
        self:_log("❌ โหลด Remote Flags ไม่สำเร็จ")
    end
end

function FeatureFlags:_hashUserId(user_id)
    local str = tostring(user_id)
    local hash = 0
    for i = 1, #str do
        hash = (hash * 31 + string.byte(str, i)) % 100
    end
    return hash
end

function FeatureFlags:_isInRollout(flag_name, percentage)
    local combined = flag_name .. tostring(self.user_id)
    local hash = 0
    for i = 1, #combined do
        hash = (hash * 31 + string.byte(combined, i)) % 100
    end
    return hash < percentage
end

function FeatureFlags:_notifyListeners(flag_name, new_value)
    local listeners = self.listeners[flag_name]
    if listeners then
        for _, callback in pairs(listeners) do
            pcall(callback, new_value)
        end
    end
end

function FeatureFlags:_log(message)
    if FF_CONFIG.DEBUG then
        print("[🚩 FeatureFlags]", message)
    end
end

