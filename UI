        function Tools:AddSlider(text, side, min, max, def, cb)
            Order = Order + 1
            local f = Instance.new("Frame", GetSide(side))
            f.Size = UDim2.new(1, 0, 0, 55)
            f.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
            f.LayoutOrder = Order
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
            
            -- Card gradient
            local cardGradient = Instance.new("UIGradient", f)
            cardGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 37, 45)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 27, 35))
            }
            cardGradient.Rotation = 45
            
            -- Border
            local border = Instance.new("UIStroke", f)
            border.Color = Color3.fromRGB(50, 52, 60)
            border.Thickness = 1
            border.Transparency = 0.5
            
            -- Label
            local label = Instance.new("TextLabel", f)
            label.Size = UDim2.new(0.6, 0, 0, 22)
            label.Position = UDim2.new(0, 12, 0, 8)
            label.Text = text
            label.TextColor3 = Color3.fromRGB(230, 230, 230)
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Font = Enum.Font.GothamBold
            label.TextSize = 13
            
            -- Value input box (คลิกได้)
            local valueBox = Instance.new("TextBox", f)
            valueBox.Size = UDim2.new(0.3, -12, 0, 22)
            valueBox.Position = UDim2.new(0.7, 0, 0, 8)
            valueBox.Text = tostring(def)
            valueBox.TextColor3 = _G.Color
            valueBox.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
            valueBox.BackgroundTransparency = 0.5
            valueBox.TextXAlignment = Enum.TextXAlignment.Center
            valueBox.Font = Enum.Font.GothamBold
            valueBox.TextSize = 14
            valueBox.PlaceholderText = tostring(def)
            valueBox.ClearTextOnFocus = false
            Instance.new("UICorner", valueBox).CornerRadius = UDim.new(0, 6)
            
            -- Border for value box
            local valueBoxBorder = Instance.new("UIStroke", valueBox)
            valueBoxBorder.Color = _G.Color
            valueBoxBorder.Thickness = 1
            valueBoxBorder.Transparency = 0.7
            
            -- Slider background (track)
            local track = Instance.new("Frame", f)
            track.Size = UDim2.new(1, -24, 0, 8)
            track.Position = UDim2.new(0, 12, 0, 38)
            track.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
            
            -- Track gradient
            local trackGradient = Instance.new("UIGradient", track)
            trackGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(45, 47, 55)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(35, 37, 45))
            }
            trackGradient.Rotation = 90
            
            -- Filled portion (progress)
            local fill = Instance.new("Frame", track)
            fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = _G.Color
            fill.BorderSizePixel = 0
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
            
            -- Fill gradient
            local fillGradient = Instance.new("UIGradient", fill)
            fillGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(88, 101, 242)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(138, 151, 255))
            }
            
            -- Fill glow
            local fillGlow = Instance.new("UIStroke", fill)
            fillGlow.Color = _G.Color
            fillGlow.Thickness = 2
            fillGlow.Transparency = 0.6
            
            -- Draggable thumb
            local thumb = Instance.new("Frame", track)
            thumb.Size = UDim2.new(0, 18, 0, 18)
            thumb.Position = UDim2.new((def - min) / (max - min), -9, 0.5, -9)
            thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            thumb.BorderSizePixel = 0
            Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)
            
            -- Thumb glow
            local thumbGlow = Instance.new("UIStroke", thumb)
            thumbGlow.Color = _G.Color
            thumbGlow.Thickness = 3
            thumbGlow.Transparency = 0.5
            
            -- Inner shadow for thumb
            local thumbInner = Instance.new("Frame", thumb)
            thumbInner.Size = UDim2.new(0, 10, 0, 10)
            thumbInner.Position = UDim2.new(0.5, -5, 0.5, -5)
            thumbInner.BackgroundColor3 = _G.Color
            thumbInner.BackgroundTransparency = 0.7
            Instance.new("UICorner", thumbInner).CornerRadius = UDim.new(1, 0)
            
            local currentValue = def
            local dragging = false
            
            local function updateSlider(input)
                local trackPos = track.AbsolutePosition.X
                local trackSize = track.AbsoluteSize.X
                local inputX = input.Position.X
                
                -- Calculate percentage (0 to 1)
                local percent = math.clamp((inputX - trackPos) / trackSize, 0, 1)
                
                -- Calculate value
                currentValue = math.floor(min + (max - min) * percent)
                
                -- Update UI
                valueBox.Text = tostring(currentValue)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                thumb.Position = UDim2.new(percent, -9, 0.5, -9)
                
                -- Pulse animation on value change
                TweenService:Create(valueBox, TweenInfo.new(0.1), {TextSize = 16}):Play()
                wait(0.1)
                TweenService:Create(valueBox, TweenInfo.new(0.1), {TextSize = 14}):Play()
                
                -- Callback
                cb(currentValue)
            end
            
            local function updateFromValue(value)
                local numValue = tonumber(value)
                if numValue then
                    -- Clamp value
                    numValue = math.clamp(math.floor(numValue), min, max)
                    currentValue = numValue
                    
                    -- Update slider position
                    local percent = (numValue - min) / (max - min)
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                    thumb.Position = UDim2.new(percent, -9, 0.5, -9)
                    valueBox.Text = tostring(numValue)
                    
                    -- Callback
                    cb(numValue)
                else
                    -- Reset to current value if invalid
                    valueBox.Text = tostring(currentValue)
                end
            end
            
            -- Value box events (สำหรับมือถือ - คลิกพิมพ์ได้เลย)
            valueBox.FocusLost:Connect(function(enterPressed)
                updateFromValue(valueBox.Text)
            end)
            
            valueBox.Focused:Connect(function()
                TweenService:Create(valueBoxBorder, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
                TweenService:Create(border, TweenInfo.new(0.2), {Color = _G.Color, Transparency = 0.2}):Play()
            end)
            
            -- Mouse/Touch events for slider
            thumb.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    -- Scale and glow animation
                    TweenService:Create(thumb, TweenInfo.new(0.2), {
                        Size = UDim2.new(0, 24, 0, 24), 
                        Position = UDim2.new(thumb.Position.X.Scale, -12, 0.5, -12)
                    }):Play()
                    TweenService:Create(thumbGlow, TweenInfo.new(0.2), {Thickness = 5, Transparency = 0.2}):Play()
                    TweenService:Create(border, TweenInfo.new(0.2), {Color = _G.Color, Transparency = 0.2}):Play()
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                    dragging = false
                    -- Scale back
                    TweenService:Create(thumb, TweenInfo.new(0.2), {
                        Size = UDim2.new(0, 18, 0, 18), 
                        Position = UDim2.new(thumb.Position.X.Scale, -9, 0.5, -9)
                    }):Play()
                    TweenService:Create(thumbGlow, TweenInfo.new(0.2), {Thickness = 3, Transparency = 0.5}):Play()
                    TweenService:Create(border, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 52, 60), Transparency = 0.5}):Play()
                    TweenService:Create(valueBoxBorder, TweenInfo.new(0.2), {Transparency = 0.7}):Play()
                end
            end)
            
            -- Click on track to jump
            track.InputBegan:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not dragging then
                    updateSlider(input)
                end
            end)
        end

        function Tools:AddDropdown(text, side, list_provider, def, cb)
            Order = Order + 1
            local open = false
            local f = Instance.new("Frame", GetSide(side))
            f.Size = UDim2.new(1, 0, 0, 38)
            f.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            f.ClipsDescendants = true
            f.LayoutOrder = Order
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
            
            local MainBtn = Instance.new("TextButton", f)
            MainBtn.Size = UDim2.new(1, 0, 0, 38)
            MainBtn.BackgroundTransparency = 1
            MainBtn.Text = "  " .. text .. " : " .. def
            MainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            MainBtn.TextXAlignment = Enum.TextXAlignment.Left
            MainBtn.Font = Enum.Font.Gotham
            MainBtn.TextSize = 13
            
            local Arrow = Instance.new("TextLabel", MainBtn)
            Arrow.Text = "▼"
            Arrow.Size = UDim2.new(0, 30, 1, 0)
            Arrow.Position = UDim2.new(1, -30, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.TextColor3 = Color3.fromRGB(150, 150, 150)
            Arrow.TextSize = 10

            local ItemHolder = Instance.new("ScrollingFrame", f)
            ItemHolder.Size = UDim2.new(1, -10, 0, 0)
            ItemHolder.Position = UDim2.new(0, 5, 0, 40)
            ItemHolder.BackgroundTransparency = 1
            ItemHolder.ScrollBarThickness = 2
            ItemHolder.ScrollBarImageColor3 = _G.Color
            
            local ItemLayout = Instance.new("UIListLayout", ItemHolder)
            ItemLayout.Padding = UDim.new(0, 4)
            ItemLayout.SortOrder = Enum.SortOrder.LayoutOrder

            local ToggleDropdown

            local function RefreshItems()
                for _, v in pairs(ItemHolder:GetChildren()) do
                    if v:IsA("TextButton") then v:Destroy() end
                end

                local currentList = (type(list_provider) == "function") and list_provider() or list_provider

                for i, v in pairs(currentList) do
                    local Item = Instance.new("TextButton", ItemHolder)
                    Item.Size = UDim2.new(1, -5, 0, 28)
                    Item.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
                    Item.Text = tostring(v)
                    Item.TextColor3 = Color3.fromRGB(200, 200, 200)
                    Item.Font = Enum.Font.Gotham
                    Item.TextSize = 12
                    Item.LayoutOrder = i
                    Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 4)
                    
                    Item.MouseEnter:Connect(function()
                        TweenService:Create(Item, TweenInfo.new(0.2), {BackgroundColor3 = _G.Color, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                    end)
                    Item.MouseLeave:Connect(function()
                        TweenService:Create(Item, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 65), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
                    end)

                    Item.MouseButton1Click:Connect(function()
                        MainBtn.Text = "  " .. text .. " : " .. tostring(v)
                        cb(v)
                        ToggleDropdown()
                    end)
                end
                ItemHolder.CanvasSize = UDim2.new(0, 0, 0, #currentList * 32)
                return #currentList
            end

            ToggleDropdown = function()
                open = not open
                
                local currentCount = 0
                if open then
                    currentCount = RefreshItems() 
                end

                local targetHeight = open and math.min(currentCount * 32, 130) or 0
                local targetSize = open and UDim2.new(1, 0, 0, 38 + targetHeight + 10) or UDim2.new(1, 0, 0, 38)
                local targetHolderSize = open and UDim2.new(1, -10, 0, targetHeight) or UDim2.new(1, -10, 0, 0)
                
                TweenService:Create(f, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = targetSize}):Play()
                TweenService:Create(ItemHolder, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = targetHolderSize}):Play()
                TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = open and 180 or 0}):Play()
            end

            MainBtn.MouseButton1Click:Connect(ToggleDropdown)
        end
        
        return Tools
    end
    return Tabs
end

