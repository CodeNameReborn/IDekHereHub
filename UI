local Pages    = {}
local firstTab = true
local activePg = nil  -- pageData ที่กำลัง active

local function tabAnim_in(lPage, rPage, dir)
    for _, p in ipairs({lPage, rPage}) do
        if Theme.TabAnim == "slide" then
            p.Position = UDim2.new(dir*0.07,0,0,0)
            TweenService:Create(p,TweenInfo.new(0.28,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),
                {Position=UDim2.new(0,0,0,0)}):Play()
        elseif Theme.TabAnim == "scale" then
            p.Position = UDim2.new(0,0,0.03,0)
            TweenService:Create(p,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
                {Position=UDim2.new(0,0,0,0)}):Play()
        elseif Theme.TabAnim == "wipe" then
            p.Position = UDim2.new(0.08,0,0,0)
            TweenService:Create(p,TweenInfo.new(0.3,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),
                {Position=UDim2.new(0,0,0,0)}):Play()
        elseif Theme.TabAnim == "flip" then
            p.Position = UDim2.new(0,0,-0.04,0)
            TweenService:Create(p,TweenInfo.new(0.3,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),
                {Position=UDim2.new(0,0,0,0)}):Play()
        elseif Theme.TabAnim == "stagger" then
            p.Position = UDim2.new(0,0,0,0)
            local kids={}
            for _,c in ipairs(p:GetChildren()) do if c:IsA("Frame") then table.insert(kids,c) end end
            for i,c in ipairs(kids) do
                c.Visible=false
                local cc=c
                task.delay(i*0.045,function() if cc and cc.Parent then cc.Visible=true end end)
            end
        else -- fade / default
            p.Position = UDim2.new(0,0,0,0)
        end
    end
end

local function selectPage(pageData)
    if activePg == pageData then return end

    -- ซ่อน page เก่า
    local dir = 1
    if activePg then
        local oldIdx = activePg.idx
        dir = pageData.idx > oldIdx and 1 or -1

        -- slide: เลื่อนออกก่อน
        if Theme.TabAnim == "slide" then
            for _, p in ipairs({activePg.left, activePg.right}) do
                TweenService:Create(p,TweenInfo.new(0.16,Enum.EasingStyle.Sine,Enum.EasingDirection.In),
                    {Position=UDim2.new(dir*-0.06,0,0,0)}):Play()
            end
            task.delay(0.16,function()
                if activePg then
                    activePg.left.Visible=false; activePg.right.Visible=false
                    activePg.left.Position=UDim2.new(0,0,0,0)
                    activePg.right.Position=UDim2.new(0,0,0,0)
                end
            end)
        else
            activePg.left.Visible=false; activePg.right.Visible=false
        end

        -- tab button ปิด
        TweenService:Create(activePg.btn,TweenInfo.new(0.15),{
            BackgroundColor3=Color3.fromRGB(38,38,38),
            TextColor3=Color3.fromRGB(180,180,180),
        }):Play()
    end

    -- เปิด page ใหม่
    activePg = pageData
    TweenService:Create(pageData.btn,TweenInfo.new(0.15),{
        BackgroundColor3=Theme.Accent,
        TextColor3=Color3.fromRGB(15,15,15),
    }):Play()

    local delay = (Theme.TabAnim=="slide") and 0.14 or 0
    task.delay(delay,function()
        pageData.left.Visible=true; pageData.right.Visible=true
        tabAnim_in(pageData.left, pageData.right, dir)
        -- อัพเดต canvas
        LeftScroll.CanvasSize=UDim2.new(0,0,0,pageData.leftLayout.AbsoluteContentSize.Y+16)
        RightScroll.CanvasSize=UDim2.new(0,0,0,pageData.rightLayout.AbsoluteContentSize.Y+16)
    end)
end

