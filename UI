            local function updateSlider(inp)
                local pos = math.clamp(inp.Position.X - bar.AbsolutePosition.X, 0, 260)
                bar1.Size = UDim2.new(0,pos,0,5)
                circlebar.Position = UDim2.new(0,pos-2,0,-3)
                local Value = math.floor(((max-min)/260)*pos+min)
                TextBox.Text = tostring(Value)
                pcall(callback, Value)
            end
            AHEHE.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    updateSlider(inp)
                    local mc, rc
                    mc = uis2.InputChanged:Connect(function(mi)
                        if mi.UserInputType == Enum.UserInputType.MouseMovement or mi.UserInputType == Enum.UserInputType.Touch then
                            updateSlider(mi)
                        end
                    end)
                    rc = uis2.InputEnded:Connect(function(ei)
                        if ei.UserInputType == Enum.UserInputType.MouseButton1 or ei.UserInputType == Enum.UserInputType.Touch then
                            mc:Disconnect() rc:Disconnect()
                        end
                    end)
                end
            end)
