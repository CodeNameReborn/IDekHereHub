    WinRadius   = 10,   -- 0-24
    CardRadius  = 6,    -- 0-16
    WinOpacity  = 0,    -- BackgroundTransparency (0=ทึบ, 0.6=โปร่ง)
    TabAnim     = "slide", -- slide | scale | wipe | flip | stagger | fade
    WinW        = 620,
    WinH        = 400,
