-- แสดง Feature Flags ทั้งหมด
local function groupFlags()
    local groups = {UI = {}, Features = {}, Admin = {}, Other = {}}
    
    for name, data in pairs(FF_Instance:getAllFlags()) do
        if name:match("^ui_") then
            table.insert(groups.UI, {name = name, data = data})
        elseif name:match("admin") or name:match("beta") then
            table.insert(groups.Admin, {name = name, data = data})
        elseif name:match("auto_") or name:match("custom_") then
            table.insert(groups.Features, {name = name, data = data})
        else
            table.insert(groups.Other, {name = name, data = data})
        end
    end
    
    return groups
end

