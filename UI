    -- Toggle
    local function mkToggle(parent, txt, def, cb)
        local f = mkCard(parent, 34); mkTxt(f, txt)
        local on = def or false
        local pill = Instance.new("TextButton", f)
        pill.AnchorPoint=Vector2.new(1,0.5); pill.Position=UDim2.new(1,-8,0.5,0)
        pill.Size=UDim2.new(0,38,0,20)
        pill.BackgroundColor3 = on and Theme.Accent or Color3.fromRGB(55,55,55)
        pill.BorderSizePixel=0; pill.Text=""; pill.AutoButtonColor=false
        Instance.new("UICorner",pill).CornerRadius=UDim.new(0,10)
        local knob = Instance.new("Frame", pill)
        knob.AnchorPoint=Vector2.new(0.5,0.5)
        knob.Position = on and UDim2.new(1,-10,0.5,0) or UDim2.new(0,10,0.5,0)
        knob.Size=UDim2.new(0,14,0,14); knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0
        Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
        onThemeChange("Accent", function(c) if on then pill.BackgroundColor3=c end end)
        local function toggle()
            on = not on
            TweenService:Create(pill,TweenInfo.new(0.2),{BackgroundColor3=on and Theme.Accent or Color3.fromRGB(55,55,55)}):Play()
            TweenService:Create(knob,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
                {Position=on and UDim2.new(1,-10,0.5,0) or UDim2.new(0,10,0.5,0)}):Play()
            pcall(cb, on)
        end
        pill.MouseButton1Click:Connect(toggle)
        pill.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then toggle() end end)
    end
