function Tools:AddDropdown(text, side, list_provider, def, cb)
    Order = Order + 1
    local open = false
    local f = Instance.new("Frame", GetSide(side))
    f.Size = UDim2.new(1, 0, 0, 38)
    f.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    f.ClipsDescendants = true
    f.LayoutOrder = Order
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    
    local MainBtn = Instance.new("TextButton", f)
    MainBtn.Size = UDim2.new(1, 0, 0, 38)
    MainBtn.BackgroundTransparency = 1
    MainBtn.Text = "  " .. text .. " : " .. def
    MainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MainBtn.TextXAlignment = Enum.TextXAlignment.Left
    MainBtn.Font = Enum.Font.Gotham
    MainBtn.TextSize = 13
    
    local Arrow = Instance.new("TextLabel", MainBtn)
    Arrow.Text = "▼"
    Arrow.Size = UDim2.new(0, 30, 1, 0)
    Arrow.Position = UDim2.new(1, -30, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.TextColor3 = Color3.fromRGB(150, 150, 150)
    Arrow.TextSize = 10

    local ItemHolder = Instance.new("ScrollingFrame", f)
    ItemHolder.Size = UDim2.new(1, -10, 0, 0)
    ItemHolder.Position = UDim2.new(0, 5, 0, 40)
    ItemHolder.BackgroundTransparency = 1
    ItemHolder.ScrollBarThickness = 2
    ItemHolder.ScrollBarImageColor3 = _G.Color
    
    local ItemLayout = Instance.new("UIListLayout", ItemHolder)
    ItemLayout.Padding = UDim.new(0, 4)
    ItemLayout.SortOrder = Enum.SortOrder.LayoutOrder

    -- ฟังก์ชันสำหรับสร้างรายการใหม่ (Refresh)
    local function RefreshItems()
        -- ลบรายการเก่า
        for _, v in pairs(ItemHolder:GetChildren()) do
            if v:IsA("TextButton") then v:Destroy() end
        end

        -- รับข้อมูลใหม่ (ตรวจสอบว่าเป็น Table หรือ Function)
        local currentList = (type(list_provider) == "function") and list_provider() or list_provider

        -- สร้างรายการใหม่
        for i, v in pairs(currentList) do
            local Item = Instance.new("TextButton", ItemHolder)
            Item.Size = UDim2.new(1, -5, 0, 28)
            Item.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
            Item.Text = tostring(v)
            Item.TextColor3 = Color3.fromRGB(200, 200, 200)
            Item.Font = Enum.Font.Gotham
            Item.TextSize = 12
            Item.LayoutOrder = i
            Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 4)
            
            Item.MouseEnter:Connect(function()
                TweenService:Create(Item, TweenInfo.new(0.2), {BackgroundColor3 = _G.Color, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            end)
            Item.MouseLeave:Connect(function()
                TweenService:Create(Item, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 65), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
            end)

            Item.MouseButton1Click:Connect(function()
                MainBtn.Text = "  " .. text .. " : " .. tostring(v)
                cb(v)
                -- ปิด Dropdown (ซึ่งจะไปเรียก ToggleDropdown อีกรอบ)
                MainBtn:Activate() 
            end)
        end
        ItemHolder.CanvasSize = UDim2.new(0, 0, 0, #currentList * 32)
        return #currentList
    end

    local function ToggleDropdown()
        open = not open
        
        local currentCount = 0
        if open then
            currentCount = RefreshItems() -- รีเฟรชข้อมูลทันทีที่ "เปิด"
        end

        local targetHeight = open and math.min(currentCount * 32, 130) or 0
        local targetSize = open and UDim2.new(1, 0, 0, 38 + targetHeight + 10) or UDim2.new(1, 0, 0, 38)
        local targetHolderSize = open and UDim2.new(1, -10, 0, targetHeight) or UDim2.new(1, -10, 0, 0)
        
        TweenService:Create(f, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = targetSize}):Play()
        TweenService:Create(ItemHolder, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = targetHolderSize}):Play()
        TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = open and 180 or 0}):Play()
    end

    MainBtn.MouseButton1Click:Connect(ToggleDropdown)
end

function Tools:AddSlider(text, side, min, max, def, cb)
    Order = Order + 1
    local f = Instance.new("Frame", GetSide(side))
    f.Size = UDim2.new(1, 0, 0, 45)
    f.BackgroundTransparency = 1
    f.LayoutOrder = Order

    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, 0, 0, 20)
    l.Text = text .. " : " .. def
    l.TextColor3 = Color3.fromRGB(220, 220, 220)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Gotham
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left

    local bg = Instance.new("Frame", f)
    bg.Size = UDim2.new(1, 0, 0, 4)
    bg.Position = UDim2.new(0, 0, 0, 30)
    bg.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = _G.Color
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", f)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    local function update()
        local p = math.clamp((UserInputService:GetMouseLocation().X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * p)
        fill.Size = UDim2.new(p, 0, 1, 0)
        l.Text = text .. " : " .. val
        cb(val)
    end

    btn.MouseButton1Down:Connect(function()
        local move; move = RunService.RenderStepped:Connect(update)
        local release; release = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                move:Disconnect()
                release:Disconnect()
            end
        end)
    end)
end

        return Tools
    end
    return Tabs
end

