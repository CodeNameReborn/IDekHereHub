    function tab:AddToggleR(t,d,cb) mkToggle(rPage,t,d,cb) end

    -- Slider
    local function mkSlider(parent, txt, mn, mx, def, cb)
        local f = mkCard(parent, 54)
        local row = Instance.new("Frame",f)
        row.BackgroundTransparency=1; row.Size=UDim2.new(1,-16,0,24); row.Position=UDim2.new(0,8,0,4)
        mkTxt(row, txt, 0, 12)
        local vb = Instance.new("TextBox",row)
        vb.AnchorPoint=Vector2.new(1,0.5); vb.Position=UDim2.new(1,0,0.5,0)
        vb.Size=UDim2.new(0,46,0,20); vb.BackgroundColor3=Color3.fromRGB(38,38,38)
        vb.BorderSizePixel=0; vb.Font=Enum.Font.Code; vb.Text=tostring(def)
        vb.TextColor3=Theme.Accent; vb.TextSize=11; vb.ClearTextOnFocus=true
        Instance.new("UICorner",vb).CornerRadius=UDim.new(0,4)
        onThemeChange("Accent", function(c) vb.TextColor3=c end)

        local ta = Instance.new("Frame",f)
        ta.BackgroundTransparency=1; ta.Position=UDim2.new(0,8,0,34); ta.Size=UDim2.new(1,-16,0,16)
        local track = Instance.new("Frame",ta)
        track.AnchorPoint=Vector2.new(0,0.5); track.Position=UDim2.new(0,0,0.5,0)
        track.Size=UDim2.new(1,0,0,4); track.BackgroundColor3=Color3.fromRGB(50,50,50); track.BorderSizePixel=0
        Instance.new("UICorner",track).CornerRadius=UDim.new(0,2)
        local pct = math.clamp((def-mn)/(mx-mn),0,1)
        local fill = Instance.new("Frame",track)
        fill.Size=UDim2.new(pct,0,1,0); fill.BackgroundColor3=Theme.Accent; fill.BorderSizePixel=0
        Instance.new("UICorner",fill).CornerRadius=UDim.new(0,2)
        onThemeChange("Accent", function(c) fill.BackgroundColor3=c end)
        local knob = Instance.new("Frame",track)
        knob.AnchorPoint=Vector2.new(0.5,0.5); knob.Position=UDim2.new(pct,0,0.5,0)
        knob.Size=UDim2.new(0,14,0,14); knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0
        Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

        local cur=def; local drag=false
        local function setV(x)
            local rel=math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
            local v=math.floor(mn+(mx-mn)*rel); cur=v
            fill.Size=UDim2.new(rel,0,1,0); knob.Position=UDim2.new(rel,0,0.5,0)
            vb.Text=tostring(v); pcall(cb,v)
        end
        ta.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;setV(i.Position.X) end
            if i.UserInputType==Enum.UserInputType.Touch then drag=true;setV(i.Position.X) end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setV(i.Position.X) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
        end)
        vb.FocusLost:Connect(function()
            local v=tonumber(vb.Text); if v then
                v=math.clamp(math.floor(v),mn,mx); cur=v
                local rel=(v-mn)/(mx-mn)
                fill.Size=UDim2.new(rel,0,1,0); knob.Position=UDim2.new(rel,0,0.5,0); pcall(cb,v)
            end; vb.Text=tostring(cur)
        end)
    end
    function tab:AddSliderL(t,mn,mx,d,cb) mkSlider(lPage,t,mn,mx,d,cb) end
    function tab:AddSliderR(t,mn,mx,d,cb) mkSlider(rPage,t,mn,mx,d,cb) end

    -- Dropdown
    local function mkDropdown(parent, title, list, def, cb)
        local IH,SH=28,30; local open=false
        local curList=list; local curSel=def or (list[1] or "Select...")
        local iBtns={}

        local wrap=Instance.new("Frame",parent)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,52); wrap.ClipsDescendants=false
        local base=mkCard(wrap,52); base.Size=UDim2.new(1,0,0,52); base.ClipsDescendants=true

        local hdr=Instance.new("TextButton",base)
        hdr.BackgroundTransparency=1; hdr.Size=UDim2.new(1,0,0,26); hdr.Text=""
        mkTxt(hdr,title,8,12)
        local arr=Instance.new("TextLabel",hdr)
        arr.BackgroundTransparency=1; arr.AnchorPoint=Vector2.new(1,0.5)
        arr.Position=UDim2.new(1,-6,0.5,0); arr.Size=UDim2.new(0,16,0,16)
        arr.Font=Enum.Font.GothamBold; arr.Text="▼"; arr.TextColor3=Theme.Accent; arr.TextSize=9
        onThemeChange("Accent",function(c) arr.TextColor3=c end)

        local sel=Instance.new("TextLabel",base)
        sel.BackgroundColor3=Color3.fromRGB(38,38,38); sel.BorderSizePixel=0
        sel.Position=UDim2.new(0,4,0,28); sel.Size=UDim2.new(1,-8,0,20)
        sel.Font=Enum.Font.Gotham; sel.Text=curSel
        sel.TextColor3=Theme.Accent; sel.TextSize=11
        Instance.new("UICorner",sel).CornerRadius=UDim.new(0,4)
        onThemeChange("Accent",function(c) sel.TextColor3=c end)

        local sb=Instance.new("TextBox",base)
        sb.BackgroundColor3=Color3.fromRGB(38,38,38); sb.BorderSizePixel=0
        sb.Position=UDim2.new(0,4,0,56); sb.Size=UDim2.new(1,-8,0,22)
        sb.Font=Enum.Font.Gotham; sb.PlaceholderText="🔍 ค้นหา..."
        sb.PlaceholderColor3=Color3.fromRGB(90,90,90); sb.Text=""
        sb.TextColor3=Color3.fromRGB(200,200,200); sb.TextSize=11; sb.ClearTextOnFocus=false
        Instance.new("UICorner",sb).CornerRadius=UDim.new(0,4)

        local iFrame=Instance.new("Frame",base)
        iFrame.BackgroundTransparency=1; iFrame.Position=UDim2.new(0,0,0,52+SH+8)
        iFrame.Size=UDim2.new(1,0,0,#curList*IH)
        Instance.new("UIListLayout",iFrame).SortOrder=Enum.SortOrder.LayoutOrder

        local function closeDD()
            open=false; sb.Text=""
            for _,b in ipairs(iBtns) do b.Visible=true end
            wrap:TweenSize(UDim2.new(1,0,0,52),"Out","Quad",0.2,true)
            base:TweenSize(UDim2.new(1,0,0,52),"Out","Quad",0.2,true)
            TweenService:Create(arr,TweenInfo.new(0.15),{Rotation=0}):Play()
        end

        local function buildItems(lst)
            -- ลบ items เก่า
            for _,b in ipairs(iBtns) do b:Destroy() end
            iBtns={}
            iFrame.Size=UDim2.new(1,0,0,#lst*IH)
            for _,item in ipairs(lst) do
                local ib=Instance.new("TextButton",iFrame)
                ib.BackgroundColor3=Color3.fromRGB(34,34,34); ib.BorderSizePixel=0
                ib.Size=UDim2.new(1,0,0,IH); ib.Font=Enum.Font.Gotham
                ib.Text=item; ib.TextColor3=Color3.fromRGB(195,195,195); ib.TextSize=11; ib.AutoButtonColor=false
                ib.MouseEnter:Connect(function() TweenService:Create(ib,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(48,48,48)}):Play() end)
                ib.MouseLeave:Connect(function() TweenService:Create(ib,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(34,34,34)}):Play() end)
                local captItem=item
                local function pick()
                    curSel=captItem; sel.Text=captItem; pcall(cb,captItem); closeDD()
                end
                ib.MouseButton1Click:Connect(pick)
                ib.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then pick() end end)
                table.insert(iBtns,ib)
            end
        end
        buildItems(curList)

        sb:GetPropertyChangedSignal("Text"):Connect(function()
            local q=sb.Text:lower(); local vis=0
            for i,ib in ipairs(iBtns) do
                local show=q=="" or curList[i]:lower():find(q,1,true)~=nil
                ib.Visible=show; if show then vis=vis+1 end
            end
            if open then
                local h=52+SH+8+(vis*IH)
                wrap:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.15,true)
                base:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.15,true)
            end
        end)

        local function toggleOpen()
            open=not open
            local h=open and (52+SH+8+#curList*IH) or 52
            wrap:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.2,true)
            base:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.2,true)
            TweenService:Create(arr,TweenInfo.new(0.2),{Rotation=open and 180 or 0}):Play()
        end
        hdr.MouseButton1Click:Connect(toggleOpen)
        hdr.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then toggleOpen() end end)

        local ddObj={}
        -- :Update(newList)  → เปลี่ยน items ทั้งหมด
        function ddObj:Update(newList)
            closeDD()
            curList=newList
            -- reset selection ถ้า item เดิมไม่อยู่ใน list ใหม่
            local found=false
            for _,v in ipairs(newList) do if v==curSel then found=true; break end end
            if not found then curSel=newList[1] or "Select..."; sel.Text=curSel end
            buildItems(curList)
        end
        -- :Set(value)  → เซ็ต selected โดยไม่ trigger callback
        function ddObj:Set(value)
            curSel=value; sel.Text=value
        end
        -- :Get()  → return ค่าปัจจุบัน
        function ddObj:Get() return curSel end

        return ddObj
    end
    function tab:AddDropdownL(t,l,d,cb) return mkDropdown(lPage,t,l,d,cb) end
    function tab:AddDropdownR(t,l,d,cb) return mkDropdown(rPage,t,l,d,cb) end

    -- Multi-select Dropdown
    local function mkMultiDropdown(parent, title, list, cb)
        local IH,SH=30,30; local open=false
        local selected={}; local curList=list; local rows={}

        local wrap=Instance.new("Frame",parent)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,52); wrap.ClipsDescendants=false
        local base=mkCard(wrap,52); base.Size=UDim2.new(1,0,0,52)
        local sk=base:FindFirstChildWhichIsA("UIStroke"); if sk then sk.Color=Color3.fromRGB(51,130,130) end
        base.ClipsDescendants=true

        local hdr=Instance.new("TextButton",base); hdr.BackgroundTransparency=1; hdr.Size=UDim2.new(1,0,0,26); hdr.Text=""
        mkTxt(hdr,"✦ "..title,8,12)
        local arr=Instance.new("TextLabel",hdr); arr.BackgroundTransparency=1; arr.AnchorPoint=Vector2.new(1,0.5)
        arr.Position=UDim2.new(1,-6,0.5,0); arr.Size=UDim2.new(0,16,0,16)
        arr.Font=Enum.Font.GothamBold; arr.Text="▼"; arr.TextColor3=Theme.Accent; arr.TextSize=9
        onThemeChange("Accent",function(c) arr.TextColor3=c end)

        local sel=Instance.new("TextLabel",base)
        sel.BackgroundColor3=Color3.fromRGB(38,38,38); sel.BorderSizePixel=0
        sel.Position=UDim2.new(0,4,0,28); sel.Size=UDim2.new(1,-8,0,20)
        sel.Font=Enum.Font.Gotham; sel.Text="เลือกหลายรายการ..."
        sel.TextColor3=Color3.fromRGB(90,90,90); sel.TextSize=10
        Instance.new("UICorner",sel).CornerRadius=UDim.new(0,4)

        local sb=Instance.new("TextBox",base); sb.BackgroundColor3=Color3.fromRGB(38,38,38); sb.BorderSizePixel=0
        sb.Position=UDim2.new(0,4,0,56); sb.Size=UDim2.new(1,-8,0,22)
        sb.Font=Enum.Font.Gotham; sb.PlaceholderText="🔍 ค้นหา..."; sb.PlaceholderColor3=Color3.fromRGB(90,90,90)
        sb.Text=""; sb.TextColor3=Color3.fromRGB(200,200,200); sb.TextSize=11; sb.ClearTextOnFocus=false
        Instance.new("UICorner",sb).CornerRadius=UDim.new(0,4)

        local iFrame=Instance.new("Frame",base); iFrame.BackgroundTransparency=1
        iFrame.Position=UDim2.new(0,0,0,52+SH+8); iFrame.Size=UDim2.new(1,0,0,#list*IH)
        Instance.new("UIListLayout",iFrame).SortOrder=Enum.SortOrder.LayoutOrder

        local function updSel()
            local k={}; for kk in pairs(selected) do table.insert(k,kk) end
            if #k==0 then
                sel.Text="เลือกหลายรายการ..."; sel.TextColor3=Color3.fromRGB(90,90,90)
            else
                sel.Text=table.concat(k,", "); sel.TextColor3=Theme.Accent
            end
            pcall(cb,selected)
        end

        local function buildRows(lst)
            for _,rd in ipairs(rows) do rd.row:Destroy() end
            rows={}
            iFrame.Size=UDim2.new(1,0,0,#lst*IH)
            for _,item in ipairs(lst) do
                local row=Instance.new("Frame",iFrame); row.BackgroundColor3=Color3.fromRGB(30,30,30)
                row.BorderSizePixel=0; row.Size=UDim2.new(1,0,0,IH)
                local chk=Instance.new("Frame",row); chk.AnchorPoint=Vector2.new(0,0.5); chk.Position=UDim2.new(0,8,0.5,0)
                chk.Size=UDim2.new(0,14,0,14); chk.BackgroundColor3=Color3.fromRGB(50,50,50); chk.BorderSizePixel=0
                Instance.new("UICorner",chk).CornerRadius=UDim.new(0,4)
                local ct=Instance.new("TextLabel",chk); ct.Size=UDim2.new(1,0,1,0); ct.BackgroundTransparency=1
                ct.Text="✓"; ct.TextColor3=Color3.fromRGB(15,15,15); ct.Font=Enum.Font.GothamBold; ct.TextSize=10
                ct.Visible = selected[item] == true  -- restore state ถ้า update แล้ว item ยังอยู่
                if selected[item] then chk.BackgroundColor3=Theme.Accent; row.BackgroundColor3=Color3.fromRGB(38,38,38) end
                local il=Instance.new("TextLabel",row); il.BackgroundTransparency=1; il.Position=UDim2.new(0,28,0,0)
                il.Size=UDim2.new(1,-32,1,0); il.Font=Enum.Font.Gotham; il.Text=item
                il.TextColor3=Color3.fromRGB(195,195,195); il.TextSize=11; il.TextXAlignment=Enum.TextXAlignment.Left
                local btn=Instance.new("TextButton",row); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
                local captItem,captChk,captCt,captRow=item,chk,ct,row
                local function tog()
                    if selected[captItem] then
                        selected[captItem]=nil
                        TweenService:Create(captChk,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(50,50,50)}):Play()
                        captCt.Visible=false
                        TweenService:Create(captRow,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(30,30,30)}):Play()
                    else
                        selected[captItem]=true
                        TweenService:Create(captChk,TweenInfo.new(0.15),{BackgroundColor3=Theme.Accent}):Play()
                        captCt.Visible=true
                        TweenService:Create(captRow,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(38,38,38)}):Play()
                    end
                    updSel()
                end
                btn.MouseButton1Click:Connect(tog)
                btn.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then tog() end end)
                table.insert(rows,{row=row,item=item})
            end
        end
        buildRows(curList)

        sb:GetPropertyChangedSignal("Text"):Connect(function()
            local q=sb.Text:lower(); local vis=0
            for _,d in ipairs(rows) do
                local show=q=="" or d.item:lower():find(q,1,true)~=nil
                d.row.Visible=show; if show then vis=vis+1 end
            end
            if open then
                local h=52+SH+8+(vis*IH)
                wrap:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.15,true)
                base:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.15,true)
            end
        end)

        local function toggleOpen()
            open=not open
            local h=open and (52+SH+8+#curList*IH) or 52
            wrap:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.2,true)
            base:TweenSize(UDim2.new(1,0,0,h),"Out","Quad",0.2,true)
            TweenService:Create(arr,TweenInfo.new(0.2),{Rotation=open and 180 or 0}):Play()
        end
        hdr.MouseButton1Click:Connect(toggleOpen)
        hdr.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then toggleOpen() end end)

        local mddObj={}
        -- :Update(newList)  → เปลี่ยน items (keeps selection ที่ยังอยู่ใน list ใหม่)
        function mddObj:Update(newList)
            open=false; sb.Text=""
            wrap:TweenSize(UDim2.new(1,0,0,52),"Out","Quad",0.15,true)
            base:TweenSize(UDim2.new(1,0,0,52),"Out","Quad",0.15,true)
            TweenService:Create(arr,TweenInfo.new(0.15),{Rotation=0}):Play()
            -- ลบ selected ที่ไม่อยู่ใน newList
            local newSet={}; for _,v in ipairs(newList) do newSet[v]=true end
            for k in pairs(selected) do if not newSet[k] then selected[k]=nil end end
            curList=newList
            buildRows(curList)
            updSel()
        end
        -- :Set({item1=true, item2=true})  → set selection โดยตรง
        function mddObj:Set(tbl)
            selected={}
            for k,v in pairs(tbl) do if v then selected[k]=v end end
            buildRows(curList)
            updSel()
        end
        -- :Get()  → return selected table
        function mddObj:Get() return selected end
        -- :Clear()  → เคลียร์ทุก selection
        function mddObj:Clear()
            selected={}
            buildRows(curList)
            updSel()
        end

        return mddObj
    end
    function tab:AddMultiDropdownL(t,l,cb) return mkMultiDropdown(lPage,t,l,cb) end
    function tab:AddMultiDropdownR(t,l,cb) return mkMultiDropdown(rPage,t,l,cb) end

    -- Separator
    local function mkSep(parent,txt)
        local f=Instance.new("Frame",parent); f.BackgroundTransparency=1; f.Size=UDim2.new(1,0,0,22)
        local l=Instance.new("TextLabel",f); l.BackgroundTransparency=1; l.Size=UDim2.new(1,0,1,0)
        l.Font=Enum.Font.GothamBold; l.Text=txt; l.TextColor3=Theme.Accent; l.TextSize=11; l.TextXAlignment=Enum.TextXAlignment.Left
        onThemeChange("Accent",function(c) l.TextColor3=c end)
    end
    function tab:AddSeperatorL(t) mkSep(lPage,t) end
    function tab:AddSeperatorR(t) mkSep(rPage,t) end

    -- Label
    local function mkLabel(parent,txt)
        local l=Instance.new("TextLabel",parent); l.BackgroundTransparency=1
        l.Size=UDim2.new(1,0,0,0); l.AutomaticSize=Enum.AutomaticSize.Y
        l.Font=Enum.Font.Gotham; l.Text=txt; l.TextColor3=Color3.fromRGB(140,140,140)
        l.TextSize=11; l.TextWrapped=true; l.TextXAlignment=Enum.TextXAlignment.Left; l.RichText=true
    end
    function tab:AddLabelL(t) mkLabel(lPage,t) end
    function tab:AddLabelR(t) mkLabel(rPage,t) end

    -- Line
    local function mkLine(parent)
        local f=Instance.new("Frame",parent); f.BackgroundColor3=Color3.fromRGB(40,40,40); f.BorderSizePixel=0; f.Size=UDim2.new(1,0,0,1)
    end
    function tab:AddLineL() mkLine(lPage) end
    function tab:AddLineR() mkLine(rPage) end

    -- Textbox
    local function mkTextbox(parent,title,ph,def,cb)
        local f=mkCard(parent,54); mkTxt(f,title,8,11)
        local tb=Instance.new("TextBox",f); tb.AnchorPoint=Vector2.new(0.5,1); tb.Position=UDim2.new(0.5,0,1,-6)
        tb.Size=UDim2.new(1,-16,0,22); tb.BackgroundColor3=Color3.fromRGB(36,36,36); tb.BorderSizePixel=0
        tb.Font=Enum.Font.Gotham; tb.PlaceholderText=ph or ""; tb.PlaceholderColor3=Color3.fromRGB(85,85,85)
        tb.Text=def or ""; tb.TextColor3=Color3.fromRGB(195,195,195); tb.TextSize=11
        Instance.new("UICorner",tb).CornerRadius=UDim.new(0,4)
        tb.FocusLost:Connect(function(e) if e then pcall(cb,tb.Text) end end)
    end
    function tab:AddTextboxL(t,ph,d,cb) mkTextbox(lPage,t,ph,d,cb) end
    function tab:AddTextboxR(t,ph,d,cb) mkTextbox(rPage,t,ph,d,cb) end

    return tab
end

