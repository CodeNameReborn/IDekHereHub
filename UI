-- FIX: ThemeCallbacks เก็บ list ของ callbacks ไม่ใช่แค่ตัวเดียว
local ThemeCallbacks = {}
local function onThemeChange(key, fn)
    if not ThemeCallbacks[key] then ThemeCallbacks[key] = {} end
    table.insert(ThemeCallbacks[key], fn)
end
local function applyTheme(key, val)
    Theme[key] = val
    if ThemeCallbacks[key] then
        for _, fn in ipairs(ThemeCallbacks[key]) do
            pcall(fn, val)
        end
    end
end

