    local function mkSlider(parent,txt,mn,mx,def,cb)
        local f=mkCard(parent,54)
        local row=Instance.new("Frame",f)
        row.BackgroundTransparency=1; row.Size=UDim2.new(1,-16,0,24); row.Position=UDim2.new(0,8,0,4)
