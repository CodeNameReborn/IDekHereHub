function Tools:AddButton(text, side, cb)
    Order = Order + 1
    local f = Instance.new("Frame", GetSide(side))
    f.Size = UDim2.new(1, 0, 0, 38)
    f.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    f.LayoutOrder = Order
    f.ClipsDescendants = true -- ป้องกันเนื้อหาเลยขอบตอนย่อขนาด
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    
    local b = Instance.new("TextButton", f)
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundTransparency = 1
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.ZIndex = 2

    --// Animation Logic //--
    local btnTweenIn = TweenService:Create(f, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, -6, 0, 34), -- ยุบขนาดลง
        BackgroundColor3 = Color3.fromRGB(35, 35, 40) -- สีเข้มขึ้น
    })
    
    local btnTweenOut = TweenService:Create(f, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 0, 38), -- กลับมาขนาดเดิม (มีแรงเด้ง)
        BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    })

    local hoverTween = TweenService:Create(f, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(55, 55, 60) -- สว่างขึ้นตอนเมาส์วาง
    })

    local leaveTween = TweenService:Create(f, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    })

    --// Connections //--
    b.MouseEnter:Connect(function() hoverTween:Play() end)
    b.MouseLeave:Connect(function() leaveTween:Play() end)
    
    b.MouseButton1Down:Connect(function()
        btnTweenIn:Play()
    end)
    
    b.MouseButton1Up:Connect(function()
        btnTweenOut:Play()
        cb() -- เรียกใช้ฟังก์ชันที่ส่งมา
    end)
end

