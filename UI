--  UI SETTINGS TAB  (เพิ่ม Tab ที่กำหนดเองด้วยฟีเจอร์นี้)
-- ══════════════════════════════════════════════════════════════
local function AddUISettingsTab()
    -- สร้าง tab ปกติ แต่ด้วย helper ที่เขียนตรงนี้แยก
    local tab = AddTab("⚙️ UI")

    -- ── helper ของ Settings Tab ──────────────────────────────
    -- หัวข้อ section
    local function addSection(page, txt)
        local f = Instance.new("Frame", page)
        f.BackgroundTransparency=1; f.Size=UDim2.new(1,0,0,24)
        local l = Instance.new("TextLabel",f); l.BackgroundTransparency=1; l.Size=UDim2.new(1,0,1,0)
        l.Font=Enum.Font.GothamBold; l.Text=txt; l.TextSize=10
        l.TextColor3=Theme.Accent; l.TextXAlignment=Enum.TextXAlignment.Left; l.RichText=true
        l.TextColor3=Color3.fromRGB(160,160,160)
        -- underline
        local ul=Instance.new("Frame",f); ul.AnchorPoint=Vector2.new(0,1); ul.Position=UDim2.new(0,0,1,0)
        ul.Size=UDim2.new(1,0,0,1); ul.BackgroundColor3=Color3.fromRGB(38,38,38); ul.BorderSizePixel=0
    end

    -- color swatch row helper
    local function addColorGrid(page, colors, onPick)
        local wrap=Instance.new("Frame",page)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,0); wrap.AutomaticSize=Enum.AutomaticSize.Y
        local grid=Instance.new("UIGridLayout",wrap)
        grid.CellSize=UDim2.new(0,22,0,22); grid.CellPadding=UDim2.new(0,5,0,5)
        grid.FillDirection=Enum.FillDirection.Horizontal; grid.SortOrder=Enum.SortOrder.LayoutOrder
        local swatches={}
        for _, col in ipairs(colors) do
            local sw=Instance.new("TextButton",wrap)
            sw.BackgroundColor3=col; sw.BorderSizePixel=0; sw.Text=""; sw.AutoButtonColor=false
            Instance.new("UICorner",sw).CornerRadius=UDim.new(0,5)
            local sk=Instance.new("UIStroke",sw); sk.Color=Color3.new(1,1,1); sk.Thickness=0
            sw.MouseButton1Click:Connect(function()
                for _,s in ipairs(swatches) do s:FindFirstChildWhichIsA("UIStroke").Thickness=0 end
                sk.Thickness=2; onPick(col)
            end)
            table.insert(swatches,sw)
        end
        return swatches, wrap
    end

    -- mini slider helper
    local function addMiniSlider(page, labelTxt, initVal, mn, mx, onVal)
        local wrap=Instance.new("Frame",page)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,28)
        local lbl=Instance.new("TextLabel",wrap); lbl.BackgroundTransparency=1
        lbl.Size=UDim2.new(0,52,1,0); lbl.Font=Enum.Font.Gotham; lbl.TextSize=10
        lbl.Text=labelTxt; lbl.TextColor3=Color3.fromRGB(130,130,130); lbl.TextXAlignment=Enum.TextXAlignment.Left
        local valLbl=Instance.new("TextLabel",wrap); valLbl.BackgroundTransparency=1
        valLbl.AnchorPoint=Vector2.new(1,0.5); valLbl.Position=UDim2.new(1,0,0.5,0)
        valLbl.Size=UDim2.new(0,38,0,20); valLbl.Font=Enum.Font.Code; valLbl.TextSize=10
        valLbl.Text=tostring(initVal); valLbl.TextColor3=Theme.Accent; valLbl.TextXAlignment=Enum.TextXAlignment.Right
        onThemeChange("Accent",function(c) valLbl.TextColor3=c end)
        local trackF=Instance.new("Frame",wrap)
        trackF.Position=UDim2.new(0,56,0.5,-2); trackF.Size=UDim2.new(1,-100,0,4)
        trackF.BackgroundColor3=Color3.fromRGB(45,45,45); trackF.BorderSizePixel=0
        Instance.new("UICorner",trackF).CornerRadius=UDim.new(0,2)
        local pct=math.clamp((initVal-mn)/(mx-mn),0,1)
        local fillF=Instance.new("Frame",trackF); fillF.Size=UDim2.new(pct,0,1,0)
        fillF.BackgroundColor3=Theme.Accent; fillF.BorderSizePixel=0
        Instance.new("UICorner",fillF).CornerRadius=UDim.new(0,2)
        onThemeChange("Accent",function(c) fillF.BackgroundColor3=c end)
        local knobF=Instance.new("Frame",trackF); knobF.AnchorPoint=Vector2.new(0.5,0.5)
        knobF.Position=UDim2.new(pct,0,0.5,0); knobF.Size=UDim2.new(0,12,0,12)
        knobF.BackgroundColor3=Color3.new(1,1,1); knobF.BorderSizePixel=0
        Instance.new("UICorner",knobF).CornerRadius=UDim.new(1,0)
        local drag=false
        local function setP(x)
            local r=trackF.AbsolutePosition.X; local w=math.max(trackF.AbsoluteSize.X,1)
            local p=math.clamp((x-r)/w,0,1)
            local v=math.floor(mn+(mx-mn)*p)
            fillF.Size=UDim2.new(p,0,1,0); knobF.Position=UDim2.new(p,0,0.5,0)
            valLbl.Text=tostring(v); onVal(v)
        end
        trackF.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;setP(i.Position.X) end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setP(i.Position.X) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
        end)
    end

    -- anim option buttons
    local function addAnimGrid(page)
        local opts={"Slide","Scale","Wipe","Flip","Stagger","Fade"}
        local keys={"slide","scale","wipe","flip","stagger","fade"}
        local btns={}
        local wrap=Instance.new("Frame",page)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,0); wrap.AutomaticSize=Enum.AutomaticSize.Y
        local grid=Instance.new("UIGridLayout",wrap)
        grid.CellSize=UDim2.new(0.5,-3,0,26); grid.CellPadding=UDim2.new(0,6,0,5)
        grid.FillDirection=Enum.FillDirection.Horizontal; grid.SortOrder=Enum.SortOrder.LayoutOrder
        for i, opt in ipairs(opts) do
            local b=Instance.new("TextButton",wrap)
            b.BackgroundColor3=keys[i]=="slide" and Color3.fromRGB(35,35,35) or Color3.fromRGB(26,26,26)
            b.BorderSizePixel=0; b.Font=Enum.Font.GothamBold; b.Text=opt; b.TextSize=10
            b.TextColor3=keys[i]=="slide" and Theme.Accent or Color3.fromRGB(100,100,100)
            b.AutoButtonColor=false
            Instance.new("UICorner",b).CornerRadius=UDim.new(0,5)
            local bsk=Instance.new("UIStroke",b)
            bsk.Color=keys[i]=="slide" and Theme.Accent or Color3.fromRGB(40,40,40); bsk.Thickness=1
            table.insert(btns,{btn=b,stroke=bsk,key=keys[i]})
            local k=keys[i]
            b.MouseButton1Click:Connect(function()
                Theme.TabAnim=k
                for _,bd in ipairs(btns) do
                    local on=(bd.key==k)
                    TweenService:Create(bd.btn,TweenInfo.new(0.15),{
                        BackgroundColor3=on and Color3.fromRGB(35,35,35) or Color3.fromRGB(26,26,26),
                        TextColor3=on and Theme.Accent or Color3.fromRGB(100,100,100),
                    }):Play()
                    bd.stroke.Color=on and Theme.Accent or Color3.fromRGB(40,40,40)
                end
            end)
        end
    end

    -- ── LEFT column: สี + พื้นหลัง ────────────────────────────
    local lP = (function()
        -- ดึง lPage ออกมาจาก tab methods — ใช้ trick inject
        -- เราสร้าง dummy frame ให้ AddSeperatorL ใส่ แล้วเอา parent กลับ
        -- แต่ง่ายกว่าคือ expose lPage จาก AddTab
        -- (วิธีนี้ใช้ frame ใน LeftScroll)
        for _,f in ipairs(LeftScroll:GetChildren()) do
            if f:IsA("Frame") and not f.Visible == false then return f end
        end
        -- หา frame ล่าสุดใน LeftScroll
        local frames=LeftScroll:GetChildren()
        for i=#frames,1,-1 do if frames[i]:IsA("Frame") then return frames[i] end end
    end)()

    -- ใช้ AddSeperatorL/R เพื่อให้ content อยู่ใน lPage/rPage ของ tab นี้
    tab:AddSeperatorL("🎨 สีหลัก (Accent)")

    -- color swatches ผ่าน AddButtonL trick → สร้าง inline frame
    -- เรา inject frame ลง lPage โดยตรงโดยดูว่า lPage คือ frame ล่าสุดใน LeftScroll
    local function getLastPage(scroll)
        local children = scroll:GetChildren()
        for i = #children, 1, -1 do
            if children[i]:IsA("Frame") then return children[i] end
        end
    end

    local lPage = getLastPage(LeftScroll)
    local rPage = getLastPage(RightScroll)

    -- Accent colors
    local ACCENT_COLORS = {
        Color3.fromRGB(51,255,255),  -- cyan default
        Color3.fromRGB(255,59,92),   -- pink
        Color3.fromRGB(168,85,247),  -- purple
        Color3.fromRGB(34,197,94),   -- green
        Color3.fromRGB(245,158,11),  -- amber
        Color3.fromRGB(59,130,246),  -- blue
        Color3.fromRGB(239,68,68),   -- red
        Color3.fromRGB(236,72,153),  -- rose
        Color3.fromRGB(20,184,166),  -- teal
        Color3.fromRGB(249,115,22),  -- orange
    }

    addColorGrid(lPage, ACCENT_COLORS, function(c)
        applyTheme("Accent", c)
        -- อัพเดต all toggle pills ที่ on
    end)

    -- spacer
    local sp1=Instance.new("Frame",lPage); sp1.BackgroundTransparency=1; sp1.Size=UDim2.new(1,0,0,4)

    addSection(lPage, "🌑 พื้นหลัง Window")

    local BG_COLORS = {
        Color3.fromRGB(17,17,17),
        Color3.fromRGB(8,8,8),
        Color3.fromRGB(16,13,28),
        Color3.fromRGB(10,22,38),
        Color3.fromRGB(12,22,12),
        Color3.fromRGB(22,16,9),
    }
    local BG_TOP = {
        Color3.fromRGB(25,25,25), Color3.fromRGB(14,14,14), Color3.fromRGB(24,20,36),
        Color3.fromRGB(16,30,50), Color3.fromRGB(18,30,18), Color3.fromRGB(30,22,14),
    }
    local BG_CARD = {
        Color3.fromRGB(28,28,28), Color3.fromRGB(18,18,18), Color3.fromRGB(28,24,40),
        Color3.fromRGB(20,34,52), Color3.fromRGB(22,32,22), Color3.fromRGB(32,24,18),
    }

    addColorGrid(lPage, BG_COLORS, function(c)
        -- หา index
        for i, col in ipairs(BG_COLORS) do
            if col == c then
                applyTheme("WinBg", c)
                applyTheme("TopBg", BG_TOP[i])
                applyTheme("CardBg", BG_CARD[i])
                break
            end
        end
    end)

    local sp2=Instance.new("Frame",lPage); sp2.BackgroundTransparency=1; sp2.Size=UDim2.new(1,0,0,4)
    addSection(lPage, "🔘 ความโค้งมุม")
    addMiniSlider(lPage, "Window", Theme.WinRadius, 0, 24, function(v) applyTheme("WinRadius", v) end)
    addMiniSlider(lPage, "Cards",  Theme.CardRadius, 0, 16, function(v) applyTheme("CardRadius", v) end)

    -- ── RIGHT column: animation + size + opacity ───────────────
    addSection(rPage, "✨ อนิเมชั่น Tab")
    addAnimGrid(rPage)

    local sp3=Instance.new("Frame",rPage); sp3.BackgroundTransparency=1; sp3.Size=UDim2.new(1,0,0,6)
    addSection(rPage, "💧 ความโปร่งใส")
    addMiniSlider(rPage, "Opacity", 100, 0, 100, function(v)
        applyTheme("WinOpacity", 1 - (v/100))
    end)

    local sp4=Instance.new("Frame",rPage); sp4.BackgroundTransparency=1; sp4.Size=UDim2.new(1,0,0,6)
    addSection(rPage, "📐 ขนาด Window")

    local SIZE_OPTS = {{"เล็ก",480,340},{"ปกติ",620,400},{"ใหญ่",760,460},{"XL",900,520}}
    local sizeBtns={}
    for _, s in ipairs(SIZE_OPTS) do
        local label,w,h = s[1],s[2],s[3]
        local sbtn=Instance.new("TextButton",rPage)
        sbtn.BackgroundColor3=Color3.fromRGB(26,26,26); sbtn.BorderSizePixel=0
        sbtn.Size=UDim2.new(1,0,0,26); sbtn.Font=Enum.Font.GothamBold; sbtn.Text=label
        sbtn.TextColor3=Color3.fromRGB(100,100,100); sbtn.TextSize=11; sbtn.AutoButtonColor=false
        Instance.new("UICorner",sbtn).CornerRadius=UDim.new(0,5)
        local ssk=Instance.new("UIStroke",sbtn); ssk.Color=Color3.fromRGB(40,40,40); ssk.Thickness=1
        table.insert(sizeBtns,{btn=sbtn,stroke=ssk})
        sbtn.MouseButton1Click:Connect(function()
            Theme.WinW=w; Theme.WinH=h
            NORMAL_SIZE=UDim2.new(0,w,0,h)
            TweenService:Create(Main,TweenInfo.new(0.4,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),{Size=NORMAL_SIZE}):Play()
            for _,sd in ipairs(sizeBtns) do
                local on=(sd.btn==sbtn)
                TweenService:Create(sd.btn,TweenInfo.new(0.15),{
                    BackgroundColor3=on and Color3.fromRGB(35,35,35) or Color3.fromRGB(26,26,26),
                    TextColor3=on and Theme.Accent or Color3.fromRGB(100,100,100),
                }):Play()
                sd.stroke.Color=on and Theme.Accent or Color3.fromRGB(40,40,40)
            end
        end)
    end

    local sp5=Instance.new("Frame",rPage); sp5.BackgroundTransparency=1; sp5.Size=UDim2.new(1,0,0,4)

    -- Reset button
    local rbtn=Instance.new("TextButton",rPage)
    rbtn.BackgroundColor3=Color3.fromRGB(22,22,22); rbtn.BorderSizePixel=0
    rbtn.Size=UDim2.new(1,0,0,28); rbtn.Font=Enum.Font.GothamBold; rbtn.Text="↺  รีเซ็ตทุกอย่าง"
    rbtn.TextColor3=Color3.fromRGB(80,80,80); rbtn.TextSize=11; rbtn.AutoButtonColor=false
    Instance.new("UICorner",rbtn).CornerRadius=UDim.new(0,5)
    local rsk=Instance.new("UIStroke",rbtn); rsk.Color=Color3.fromRGB(40,40,40); rsk.Thickness=1
    rbtn.MouseEnter:Connect(function() TweenService:Create(rbtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(30,10,10),TextColor3=Color3.fromRGB(255,80,80)}):Play(); rsk.Color=Color3.fromRGB(180,50,50) end)
    rbtn.MouseLeave:Connect(function() TweenService:Create(rbtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(22,22,22),TextColor3=Color3.fromRGB(80,80,80)}):Play(); rsk.Color=Color3.fromRGB(40,40,40) end)
    rbtn.MouseButton1Click:Connect(function()
        applyTheme("Accent",    Color3.fromRGB(51,255,255))
        applyTheme("WinBg",     Color3.fromRGB(17,17,17))
        applyTheme("TopBg",     Color3.fromRGB(25,25,25))
        applyTheme("CardBg",    Color3.fromRGB(28,28,28))
        applyTheme("WinRadius", 10)
        applyTheme("CardRadius",6)
        applyTheme("WinOpacity",0)
        Theme.TabAnim = "slide"
        Theme.WinW=620; Theme.WinH=400
        NORMAL_SIZE=UDim2.new(0,620,0,400)
        TweenService:Create(Main,TweenInfo.new(0.4,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),{Size=NORMAL_SIZE}):Play()
        AddNotification("รีเซ็ต UI เรียบร้อยแล้ว!")
    end)

    return tab
end

