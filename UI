--  UI SETTINGS TAB
-- ══════════════════════════════════════════════════════════════
local function AddUISettingsTab()
    local tab = AddTab("⚙️ UI")
    -- FIX: ใช้ tab._lPage / tab._rPage โดยตรง ไม่ใช้ getLastPage hack
    local lPage = tab._lPage
    local rPage = tab._rPage

    local function addSection(page,txt)
        local f=Instance.new("Frame",page); f.BackgroundTransparency=1; f.Size=UDim2.new(1,0,0,22)
        local l=Instance.new("TextLabel",f); l.BackgroundTransparency=1; l.Size=UDim2.new(1,0,1,0)
        l.Font=Enum.Font.GothamBold; l.Text=txt; l.TextSize=10
        l.TextColor3=Color3.fromRGB(155,155,155); l.TextXAlignment=Enum.TextXAlignment.Left
        local ul=Instance.new("Frame",f); ul.AnchorPoint=Vector2.new(0,1); ul.Position=UDim2.new(0,0,1,0)
        ul.Size=UDim2.new(1,0,0,1); ul.BackgroundColor3=Color3.fromRGB(38,38,38); ul.BorderSizePixel=0
    end

    local function addColorGrid(page,colors,onPick)
        local wrap=Instance.new("Frame",page)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,0); wrap.AutomaticSize=Enum.AutomaticSize.Y
        local grid=Instance.new("UIGridLayout",wrap)
        grid.CellSize=UDim2.new(0,22,0,22); grid.CellPadding=UDim2.new(0,5,0,5)
        grid.FillDirection=Enum.FillDirection.Horizontal; grid.SortOrder=Enum.SortOrder.LayoutOrder
        local swatches={}
        for _,col in ipairs(colors) do
            local sw=Instance.new("TextButton",wrap)
            sw.BackgroundColor3=col; sw.BorderSizePixel=0; sw.Text=""; sw.AutoButtonColor=false
            Instance.new("UICorner",sw).CornerRadius=UDim.new(0,5)
            local sk=Instance.new("UIStroke",sw); sk.Color=Color3.new(1,1,1); sk.Thickness=0
            local capSk=sk
            sw.MouseButton1Click:Connect(function()
                for _,s in ipairs(swatches) do s:FindFirstChildWhichIsA("UIStroke").Thickness=0 end
                capSk.Thickness=2; onPick(col)
            end)
            table.insert(swatches,sw)
        end
    end

    local function addMiniSlider(page,label,init,mn,mx,onVal)
        local wrap=Instance.new("Frame",page)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,28)
        local lbl=Instance.new("TextLabel",wrap); lbl.BackgroundTransparency=1
        lbl.Size=UDim2.new(0,52,1,0); lbl.Font=Enum.Font.Gotham; lbl.TextSize=10
        lbl.Text=label; lbl.TextColor3=Color3.fromRGB(130,130,130); lbl.TextXAlignment=Enum.TextXAlignment.Left
        local vLbl=Instance.new("TextLabel",wrap); vLbl.BackgroundTransparency=1
        vLbl.AnchorPoint=Vector2.new(1,0.5); vLbl.Position=UDim2.new(1,0,0.5,0)
        vLbl.Size=UDim2.new(0,38,0,20); vLbl.Font=Enum.Font.Code; vLbl.TextSize=10
        vLbl.Text=tostring(init); vLbl.TextColor3=Theme.Accent; vLbl.TextXAlignment=Enum.TextXAlignment.Right
        onThemeChange("Accent",function(c) if vLbl and vLbl.Parent then vLbl.TextColor3=c end end)
        local tF=Instance.new("Frame",wrap)
        tF.Position=UDim2.new(0,56,0.5,-2); tF.Size=UDim2.new(1,-100,0,4)
        tF.BackgroundColor3=Color3.fromRGB(45,45,45); tF.BorderSizePixel=0
        Instance.new("UICorner",tF).CornerRadius=UDim.new(0,2)
        local p0=math.clamp((init-mn)/(mx-mn),0,1)
        local fF=Instance.new("Frame",tF); fF.Size=UDim2.new(p0,0,1,0)
        fF.BackgroundColor3=Theme.Accent; fF.BorderSizePixel=0
        Instance.new("UICorner",fF).CornerRadius=UDim.new(0,2)
        onThemeChange("Accent",function(c) if fF and fF.Parent then fF.BackgroundColor3=c end end)
        local kF=Instance.new("Frame",tF); kF.AnchorPoint=Vector2.new(0.5,0.5)
        kF.Position=UDim2.new(p0,0,0.5,0); kF.Size=UDim2.new(0,12,0,12)
        kF.BackgroundColor3=Color3.new(1,1,1); kF.BorderSizePixel=0
        Instance.new("UICorner",kF).CornerRadius=UDim.new(1,0)
        local drag=false
        local function setP(x)
            local r=tF.AbsolutePosition.X; local w=math.max(tF.AbsoluteSize.X,1)
            local p=math.clamp((x-r)/w,0,1); local v=math.floor(mn+(mx-mn)*p)
            fF.Size=UDim2.new(p,0,1,0); kF.Position=UDim2.new(p,0,0.5,0)
            vLbl.Text=tostring(v); onVal(v)
        end
        tF.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;setP(i.Position.X) end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setP(i.Position.X) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
        end)
    end

    local function addAnimGrid(page)
        local opts={"Slide","Scale","Wipe","Flip","Stagger","Fade"}
        local keys={"slide","scale","wipe","flip","stagger","fade"}
        local btns={}
        local wrap=Instance.new("Frame",page)
        wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,0); wrap.AutomaticSize=Enum.AutomaticSize.Y
        local grid=Instance.new("UIGridLayout",wrap)
        grid.CellSize=UDim2.new(0.5,-3,0,26); grid.CellPadding=UDim2.new(0,6,0,5)
        grid.FillDirection=Enum.FillDirection.Horizontal; grid.SortOrder=Enum.SortOrder.LayoutOrder
        for i,opt in ipairs(opts) do
            local b=Instance.new("TextButton",wrap)
            local isActive=keys[i]==Theme.TabAnim
            b.BackgroundColor3=isActive and Color3.fromRGB(35,35,35) or Color3.fromRGB(26,26,26)
            b.BorderSizePixel=0; b.Font=Enum.Font.GothamBold; b.Text=opt; b.TextSize=10
            b.TextColor3=isActive and Theme.Accent or Color3.fromRGB(100,100,100); b.AutoButtonColor=false
            Instance.new("UICorner",b).CornerRadius=UDim.new(0,5)
            local bsk=Instance.new("UIStroke",b)
            bsk.Color=isActive and Theme.Accent or Color3.fromRGB(40,40,40); bsk.Thickness=1
            table.insert(btns,{btn=b,stroke=bsk,key=keys[i]})
            local k=keys[i]
            b.MouseButton1Click:Connect(function()
                Theme.TabAnim=k
                for _,bd in ipairs(btns) do
                    local on=(bd.key==k)
                    TweenService:Create(bd.btn,TweenInfo.new(0.15),{
                        BackgroundColor3=on and Color3.fromRGB(35,35,35) or Color3.fromRGB(26,26,26),
                        TextColor3=on and Theme.Accent or Color3.fromRGB(100,100,100),
                    }):Play()
                    bd.stroke.Color=on and Theme.Accent or Color3.fromRGB(40,40,40)
                end
            end)
        end
    end

    -- LEFT: สี + พื้นหลัง + มุม
    addSection(lPage,"🎨 สีหลัก (Accent)")
    addColorGrid(lPage,{
        Color3.fromRGB(51,255,255), Color3.fromRGB(255,59,92),  Color3.fromRGB(168,85,247),
        Color3.fromRGB(34,197,94),  Color3.fromRGB(245,158,11), Color3.fromRGB(59,130,246),
        Color3.fromRGB(239,68,68),  Color3.fromRGB(236,72,153), Color3.fromRGB(20,184,166),
        Color3.fromRGB(249,115,22),
    },function(c) applyTheme("Accent",c) end)

    local sp1=Instance.new("Frame",lPage); sp1.BackgroundTransparency=1; sp1.Size=UDim2.new(1,0,0,4)
    addSection(lPage,"🌑 พื้นหลัง")
    local BG={{Color3.fromRGB(17,17,17),Color3.fromRGB(25,25,25),Color3.fromRGB(28,28,28)},
              {Color3.fromRGB(8,8,8),Color3.fromRGB(14,14,14),Color3.fromRGB(18,18,18)},
              {Color3.fromRGB(16,13,28),Color3.fromRGB(24,20,36),Color3.fromRGB(28,24,40)},
              {Color3.fromRGB(10,22,38),Color3.fromRGB(16,30,50),Color3.fromRGB(20,34,52)},
              {Color3.fromRGB(12,22,12),Color3.fromRGB(18,30,18),Color3.fromRGB(22,32,22)},
              {Color3.fromRGB(22,16,9),Color3.fromRGB(30,22,14),Color3.fromRGB(32,24,18)}}
    local bgMain={}; for _,b in ipairs(BG) do table.insert(bgMain,b[1]) end
    addColorGrid(lPage,bgMain,function(c)
        for _,b in ipairs(BG) do
            if b[1]==c then
                applyTheme("WinBg",b[1]); applyTheme("TopBg",b[2]); applyTheme("CardBg",b[3]); break
            end
        end
    end)

    local sp2=Instance.new("Frame",lPage); sp2.BackgroundTransparency=1; sp2.Size=UDim2.new(1,0,0,4)
    addSection(lPage,"🔘 มุมโค้ง")
    addMiniSlider(lPage,"Window",Theme.WinRadius,0,24,function(v) applyTheme("WinRadius",v) end)
    addMiniSlider(lPage,"Cards",Theme.CardRadius,0,16,function(v) applyTheme("CardRadius",v) end)

    -- RIGHT: animation + opacity + size + reset
    addSection(rPage,"✨ อนิเมชั่น Tab")
    addAnimGrid(rPage)

    local sp3=Instance.new("Frame",rPage); sp3.BackgroundTransparency=1; sp3.Size=UDim2.new(1,0,0,6)
    addSection(rPage,"💧 ความโปร่งใส")
    addMiniSlider(rPage,"Opacity",100,0,100,function(v) applyTheme("WinOpacity",1-(v/100)) end)

    local sp4=Instance.new("Frame",rPage); sp4.BackgroundTransparency=1; sp4.Size=UDim2.new(1,0,0,6)
    addSection(rPage,"📐 ขนาด Window")
    local sizeOpts={{"เล็ก",480,340},{"ปกติ",620,400},{"ใหญ่",760,460},{"XL",900,520}}
    local sBtns={}
    for _,s in ipairs(sizeOpts) do
        local lbl,w,h=s[1],s[2],s[3]
        local sb=Instance.new("TextButton",rPage)
        sb.BackgroundColor3=Color3.fromRGB(26,26,26); sb.BorderSizePixel=0
        sb.Size=UDim2.new(1,0,0,26); sb.Font=Enum.Font.GothamBold; sb.Text=lbl
        sb.TextColor3=Color3.fromRGB(100,100,100); sb.TextSize=11; sb.AutoButtonColor=false
        Instance.new("UICorner",sb).CornerRadius=UDim.new(0,5)
        local ssk=Instance.new("UIStroke",sb); ssk.Color=Color3.fromRGB(40,40,40); ssk.Thickness=1
        table.insert(sBtns,{btn=sb,stroke=ssk})
        sb.MouseButton1Click:Connect(function()
            Theme.WinW=w; Theme.WinH=h
            NORMAL_SIZE=UDim2.new(0,w,0,h)
            TweenService:Create(Main,TweenInfo.new(0.4,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),{Size=NORMAL_SIZE}):Play()
            for _,sd in ipairs(sBtns) do
                local on=(sd.btn==sb)
                TweenService:Create(sd.btn,TweenInfo.new(0.15),{
                    BackgroundColor3=on and Color3.fromRGB(35,35,35) or Color3.fromRGB(26,26,26),
                    TextColor3=on and Theme.Accent or Color3.fromRGB(100,100,100),
                }):Play()
                sd.stroke.Color=on and Theme.Accent or Color3.fromRGB(40,40,40)
            end
        end)
    end

    local sp5=Instance.new("Frame",rPage); sp5.BackgroundTransparency=1; sp5.Size=UDim2.new(1,0,0,4)
    local rbtn=Instance.new("TextButton",rPage)
    rbtn.BackgroundColor3=Color3.fromRGB(22,22,22); rbtn.BorderSizePixel=0
    rbtn.Size=UDim2.new(1,0,0,28); rbtn.Font=Enum.Font.GothamBold; rbtn.Text="↺  รีเซ็ตทุกอย่าง"
    rbtn.TextColor3=Color3.fromRGB(80,80,80); rbtn.TextSize=11; rbtn.AutoButtonColor=false
    Instance.new("UICorner",rbtn).CornerRadius=UDim.new(0,5)
    local rsk=Instance.new("UIStroke",rbtn); rsk.Color=Color3.fromRGB(40,40,40); rsk.Thickness=1
    rbtn.MouseEnter:Connect(function()
        TweenService:Create(rbtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(30,10,10),TextColor3=Color3.fromRGB(255,80,80)}):Play()
        rsk.Color=Color3.fromRGB(180,50,50)
    end)
    rbtn.MouseLeave:Connect(function()
        TweenService:Create(rbtn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(22,22,22),TextColor3=Color3.fromRGB(80,80,80)}):Play()
        rsk.Color=Color3.fromRGB(40,40,40)
    end)
    rbtn.MouseButton1Click:Connect(function()
        applyTheme("Accent",Color3.fromRGB(51,255,255))
        applyTheme("WinBg",Color3.fromRGB(17,17,17))
        applyTheme("TopBg",Color3.fromRGB(25,25,25))
        applyTheme("CardBg",Color3.fromRGB(28,28,28))
        applyTheme("WinRadius",10); applyTheme("CardRadius",6); applyTheme("WinOpacity",0)
        Theme.TabAnim="slide"; Theme.WinW=620; Theme.WinH=400
        NORMAL_SIZE=UDim2.new(0,620,0,400)
        TweenService:Create(Main,TweenInfo.new(0.4,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out),{Size=NORMAL_SIZE}):Play()
        AddNotification("รีเซ็ต UI เรียบร้อยแล้ว!")
    end)
end

