-- ── Tab animation helpers ─────────────────────────────────────
-- Roblox Frame ไม่มี GroupTransparency → ใช้ Visible + Position เท่านั้น

local function tabAnim_out(lPage, rPage, dir)
    local function hide(p)
        if not p then return end
        local anim = Theme.TabAnim
        if anim == "slide" then
            -- เลื่อนออกไปทางตรงข้าม
            TweenService:Create(p, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
                {Position = UDim2.new(dir * -0.08, 0, 0, 0)}):Play()
            task.delay(0.18, function() p.Visible = false; p.Position = UDim2.new(0,0,0,0) end)
        elseif anim == "wipe" then
            -- ซ่อนทันที แล้วให้ in-anim ดูเหมือน wipe
            p.Visible = false
        elseif anim == "stagger" then
            -- ซ่อนทีละชิ้นจากล่างขึ้นบน
            local kids = p:GetChildren()
            for i = #kids, 1, -1 do
                local child = kids[i]
                if child:IsA("Frame") or child:IsA("TextLabel") then
                    local delay = (#kids - i) * 0.03
                    task.delay(delay, function() if child and child.Parent then child.Visible = false end end)
                end
            end
            task.delay(0.2, function() p.Visible = false end)
        else
            -- scale / flip / fade → ซ่อนทันที
            p.Visible = false
        end
    end
    hide(lPage); hide(rPage)
end

local function tabAnim_in(lPage, rPage, dir)
    local function show(p)
        if not p then return end
        local anim = Theme.TabAnim
        p.Visible = true

        if anim == "slide" then
            -- เริ่มจากนอกขอบ แล้ว tween เข้ามา
            p.Position = UDim2.new(dir * 0.08, 0, 0, 0)
            TweenService:Create(p, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
                {Position = UDim2.new(0,0,0,0)}):Play()

        elseif anim == "scale" then
            -- ขยับจากล่างขึ้นมาเล็กน้อยพร้อม easing back
            p.Position = UDim2.new(0, 0, 0.04, 0)
            TweenService:Create(p, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {Position = UDim2.new(0,0,0,0)}):Play()

        elseif anim == "wipe" then
            -- เลื่อนเข้าจากขวา
            p.Position = UDim2.new(0.1, 0, 0, 0)
            TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
                {Position = UDim2.new(0,0,0,0)}):Play()

        elseif anim == "flip" then
            -- เลื่อนจากด้านบนลงมา
            p.Position = UDim2.new(0, 0, -0.04, 0)
            TweenService:Create(p, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
                {Position = UDim2.new(0,0,0,0)}):Play()

        elseif anim == "stagger" then
            -- แต่ละ child ปรากฏทีละตัว (ข้าม UIListLayout)
            p.Position = UDim2.new(0,0,0,0)
            local kids = {}
            for _, child in ipairs(p:GetChildren()) do
                if child:IsA("Frame") then table.insert(kids, child) end
            end
            for i, child in ipairs(kids) do
                child.Visible = false
                local capturedChild = child
                task.delay(i * 0.05, function()
                    if capturedChild and capturedChild.Parent then
                        capturedChild.Visible = true
                    end
                end)
            end

        else
            -- fade → แค่โชว์ทันที (Roblox Frame ไม่มี transparency tween ง่ายๆ)
            p.Position = UDim2.new(0,0,0,0)
        end
    end
    show(lPage); show(rPage)
end

local function AddTab(tabname)
    local tab = {}
    local isFst = firstTab; firstTab = false
    local tabIdx = #Pages + 1

    -- tab button
    local tabBtn = Instance.new("TextButton", TabScroll)
    tabBtn.BackgroundColor3 = isFst and Theme.Accent or Color3.fromRGB(38,38,38)
    tabBtn.Size = UDim2.new(0,0,1,-4); tabBtn.AutomaticSize = Enum.AutomaticSize.X
    tabBtn.BorderSizePixel = 0; tabBtn.Font = Enum.Font.GothamBold
    tabBtn.Text = " "..tabname.." "
    tabBtn.TextColor3 = isFst and Color3.fromRGB(15,15,15) or Color3.fromRGB(180,180,180)
    tabBtn.TextSize = 11
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0,5)
    local tbP = Instance.new("UIPadding", tabBtn)
    tbP.PaddingLeft=UDim.new(0,6); tbP.PaddingRight=UDim.new(0,6)

    onThemeChange("Accent", function(c)
        if tabBtn == currentTab and currentTab ~= nil then
            tabBtn.BackgroundColor3 = c
        end
    end)

    -- pages (left + right)
    local lPage = Instance.new("Frame", LeftScroll)
    lPage.BackgroundTransparency=1; lPage.Size=UDim2.new(1,0,0,0)
    lPage.AutomaticSize=Enum.AutomaticSize.Y; lPage.BorderSizePixel=0; lPage.Visible=isFst
    local lLL = Instance.new("UIListLayout",lPage); lLL.SortOrder=Enum.SortOrder.LayoutOrder; lLL.Padding=UDim.new(0,4)

    local rPage = Instance.new("Frame", RightScroll)
    rPage.BackgroundTransparency=1; rPage.Size=UDim2.new(1,0,0,0)
    rPage.AutomaticSize=Enum.AutomaticSize.Y; rPage.BorderSizePixel=0; rPage.Visible=isFst
    local rLL = Instance.new("UIListLayout",rPage); rLL.SortOrder=Enum.SortOrder.LayoutOrder; rLL.Padding=UDim.new(0,4)

    local pageData = {btn=tabBtn, left=lPage, right=rPage, idx=tabIdx}
    table.insert(Pages, pageData)
    if isFst then currentTab = tabBtn end

    local function selectTab()
        local oldPage = nil
        local dir = 1
        for _, pg in ipairs(Pages) do
            if pg.btn == currentTab then
                dir = tabIdx > pg.idx and 1 or -1
                oldPage = pg
            end
        end

        -- animate out old
        if oldPage and oldPage.btn ~= tabBtn then
            tabAnim_out(oldPage.left, oldPage.right, dir)
        end

        -- update buttons
        for _, pg in ipairs(Pages) do
            local on = (pg.btn == tabBtn)
            TweenService:Create(pg.btn, TweenInfo.new(0.15), {
                BackgroundColor3 = on and Theme.Accent or Color3.fromRGB(38,38,38),
                TextColor3       = on and Color3.fromRGB(15,15,15) or Color3.fromRGB(180,180,180),
            }):Play()
        end
        currentTab = tabBtn

        -- animate in new (รอให้ out-anim เสร็จก่อน)
        local inDelay = (Theme.TabAnim == "slide") and 0.16 or 0.05
        task.delay(inDelay, function()
            lPage.Visible = true; rPage.Visible = true
            tabAnim_in(lPage, rPage, dir)
        end)
    end

    tabBtn.MouseButton1Click:Connect(selectTab)
    tabBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then selectTab() end
    end)

    -- ── Component helpers ──────────────────────────────────────
    local allCards = {}  -- track cards for theme update

    local function mkCard(parent, h)
        local f = Instance.new("Frame", parent)
        f.BackgroundColor3 = Theme.CardBg
        f.Size = UDim2.new(1, 0, 0, h or 38); f.BorderSizePixel = 0
        local fc = Instance.new("UICorner", f); fc.CornerRadius = UDim.new(0, Theme.CardRadius)
        local sk = Instance.new("UIStroke", f); sk.Color = Theme.CardStroke; sk.Thickness = 1
        table.insert(allCards, {frame=f, corner=fc, stroke=sk})
        onThemeChange("CardBg",     function(c) f.BackgroundColor3 = c end)
        onThemeChange("CardRadius", function(r) fc.CornerRadius = UDim.new(0,r) end)
        onThemeChange("CardStroke", function(c) sk.Color = c end)
        return f
    end

    local function mkTxt(parent, txt, x, sz)
        local l = Instance.new("TextLabel", parent)
        l.BackgroundTransparency=1; l.Position=UDim2.new(0,x or 8,0,0)
        l.Size=UDim2.new(1,-(x or 8)-4,1,0); l.Font=Enum.Font.Gotham
        l.Text=txt; l.TextColor3=Theme.Text; l.TextSize=sz or 12
        l.TextXAlignment=Enum.TextXAlignment.Left
        onThemeChange("Text", function(c) l.TextColor3=c end)
        return l
    end

    -- Button
    local function mkButton(parent, txt, cb)
        local f = mkCard(parent, 34)
        local b = Instance.new("TextButton", f)
        b.BackgroundTransparency=1; b.Size=UDim2.new(1,0,1,0)
        b.Font=Enum.Font.GothamSemibold; b.Text=txt
        b.TextColor3=Theme.Accent; b.TextSize=12; b.AutoButtonColor=false
        onThemeChange("Accent", function(c) b.TextColor3=c end)
