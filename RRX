-- Get services and local player
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local plr = Players.LocalPlayer

local blackScreenUI = nil
local blackScreenFrame = nil

local function toggleBlackScreen(enable)
    pcall(function()
        if enable then
            -- ถ้ามี UI อยู่แล้ว แต่ถูกปิด ให้เปิดใหม่
            if blackScreenUI then
                blackScreenUI.Enabled = true
                blackScreenUI.Parent = plr:WaitForChild("PlayerGui", 5)
                return
            end
            
            -- รอ PlayerGui ให้พร้อม
            local playerGui = plr:FindFirstChild("PlayerGui")
            if not playerGui then
                playerGui = plr:WaitForChild("PlayerGui", 5)
                if not playerGui then return end
            end
            
            -- สร้าง black screen ใหม่
            blackScreenUI = Instance.new("ScreenGui")
            blackScreenUI.Name = "Blackscreen"
            blackScreenUI.DisplayOrder = 999  -- ให้อยู่ข้างบนสุด
            blackScreenUI.ResetOnSpawn = false
            blackScreenUI.IgnoreGuiInset = true
            blackScreenUI.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            blackScreenUI.Parent = playerGui
            
            blackScreenFrame = Instance.new("Frame", blackScreenUI)
            blackScreenFrame.BackgroundColor3 = Color3.new(0, 0, 0)
            blackScreenFrame.Size = UDim2.new(1, 0, 1, 0)
            blackScreenFrame.BorderSizePixel = 0
            blackScreenFrame.BackgroundTransparency = 0
            
            -- ปิด 3D rendering ถ้าใช้ได้
            local success, err = pcall(function() 
                RunService:Set3dRenderingEnabled(false) 
            end)
            if not success then
                -- ถ้าใช้ไม่ได้ ไม่เป็นไร แค่มีหน้าจอดำก็พอ
            end
        else
            -- ปิด black screen
            if blackScreenUI then
                blackScreenUI.Enabled = false
                -- ไม่ต้องทำลาย GUI ไว้ใช้ครั้งหน้า
            end
            
            -- เปิด 3D rendering กลับ
            pcall(function() 
                RunService:Set3dRenderingEnabled(true) 
            end)
        end
    end)
end

