local Pages={};local firstTab=true;local activePg=nil

local function tabAnim_in(lPage,rPage,dir)
    for _,p in ipairs({lPage,rPage}) do
        if Theme.TabAnim=="slide" then
            p.Position=UDim2.new(dir*0.06,0,0,0)
            TweenService:Create(p,TweenInfo.new(0.22,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,0)}):Play()
        elseif Theme.TabAnim=="bounce" then
            p.Position=UDim2.new(0,0,0.04,0)
            TweenService:Create(p,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,0)}):Play()
        elseif Theme.TabAnim=="stagger" then
            p.Position=UDim2.new(0,0,0,0)
            local kids={}
            for _,c in ipairs(p:GetChildren()) do if c:IsA("Frame") then table.insert(kids,c) end end
            for i,c in ipairs(kids) do
                c.Visible=false
                local cc=c
                task.delay(i*0.04,function()
                    if cc and cc.Parent then cc.Visible=true end
                end)
            end
        elseif Theme.TabAnim=="scale" then
            p.Position=UDim2.new(0,0,0,0)
            local siz=p.Size; p.Size=UDim2.new(siz.X.Scale*0.92,siz.X.Offset,siz.Y.Scale,siz.Y.Offset)
            TweenService:Create(p,TweenInfo.new(0.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=siz}):Play()
        elseif Theme.TabAnim=="zoom" then
            p.Position=UDim2.new(0,0,0.02,0)
            TweenService:Create(p,TweenInfo.new(0.25,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,0)}):Play()
        else -- fade
            p.Position=UDim2.new(0,0,0,0)
            -- fade each child card individually
            for _,c in ipairs(p:GetChildren()) do
                if c:IsA("Frame") and c.BackgroundTransparency<1 then
                    local orig=c.BackgroundTransparency; c.BackgroundTransparency=1
                    TweenService:Create(c,TweenInfo.new(0.25,Enum.EasingStyle.Sine),{BackgroundTransparency=orig}):Play()
                end
            end
        end
    end
end

local isSwitching=false
local function selectPage(pageData)
    if activePg==pageData then return end
    if isSwitching then
        for _,pg in ipairs(Pages) do
            pg.left.Visible=false; pg.right.Visible=false; pg.left.Active=false; pg.right.Active=false
            pg.left.Position=UDim2.new(0,0,0,0); pg.right.Position=UDim2.new(0,0,0,0)
            TweenService:Create(pg.btn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(38,38,38),TextColor3=Color3.fromRGB(180,180,180)}):Play()
        end; isSwitching=false
    end
    local oldPg=activePg; local dir=1
    if oldPg then dir=pageData.idx>oldPg.idx and 1 or -1 end
    if oldPg then TweenService:Create(oldPg.btn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(38,38,38),TextColor3=Color3.fromRGB(180,180,180)}):Play() end
    TweenService:Create(pageData.btn,TweenInfo.new(0.15),{BackgroundColor3=Theme.Accent,TextColor3=Color3.fromRGB(15,15,15)}):Play()
    activePg=pageData
    local OUT=(Theme.TabAnim=="slide" or Theme.TabAnim=="bounce" or Theme.TabAnim=="zoom") and 0.14 or 0
    isSwitching=true
    if oldPg then
        if Theme.TabAnim=="slide" then
            for _,p in ipairs({oldPg.left,oldPg.right}) do
                TweenService:Create(p,TweenInfo.new(0.14,Enum.EasingStyle.Sine,Enum.EasingDirection.In),{Position=UDim2.new(dir*-0.06,0,0,0)}):Play()
            end
        elseif Theme.TabAnim=="zoom" then
            for _,p in ipairs({oldPg.left,oldPg.right}) do
                TweenService:Create(p,TweenInfo.new(0.14,Enum.EasingStyle.Sine,Enum.EasingDirection.In),{Position=UDim2.new(0,0,dir*-0.02,0)}):Play()
            end
        end
        local sL,sR=oldPg.left,oldPg.right
        task.delay(OUT,function() sL.Visible=false; sR.Visible=false; sL.Active=false; sR.Active=false; sL.Position=UDim2.new(0,0,0,0); sR.Position=UDim2.new(0,0,0,0) end)
    end
    local snap=pageData
    task.delay(OUT,function()
        if activePg~=snap then isSwitching=false; return end
        snap.left.Visible=true; snap.right.Visible=true; snap.left.Active=true; snap.right.Active=true
        tabAnim_in(snap.left,snap.right,dir); isSwitching=false
    end)
end

