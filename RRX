local _avatarCache = {}
local function getAvatar(userId)
    if _avatarCache[userId] then return _avatarCache[userId] end
    local fallback = "https://www.roblox.com/headshot-thumbnail/image?userId="..userId.."&width=420&height=420&format=png"
    local req = http_request or request or (syn and syn.request)
    if type(req) ~= "function" then return fallback end
    local ok, res = pcall(function()
        return req({ Url="https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="..userId.."&size=420x420&format=Png", Method="GET" })
    end)
    if not ok or not res or not res.Body then return fallback end
    local parsed
    if HttpService then
        local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if decodeOk then parsed = decoded end
    end
    local url = parsed and parsed.data and parsed.data[1] and parsed.data[1].imageUrl
    local result = (url and url ~= "") and url or fallback
    _avatarCache[userId] = result
    return result
end

local WH_COLOR_PRESETS = {
    ["Green / Red"]     = {win=0x00E676, lose=0xFF1744},
    ["Blue / Orange"]   = {win=0x3B82F6, lose=0xF97316},
    ["Purple / Yellow"] = {win=0xA855F7, lose=0xEAB308},
    ["Cyan / Pink"]     = {win=0x06B6D4, lose=0xEC4899},
    ["White / Black"]   = {win=0xFFFFFF, lose=0x111111},
    ["Gold / Dark"]     = {win=0xF59E0B, lose=0x374151},
}

local function sendWebhook(isWin, RewardsText, GameTime, player)
    if not player then return false end
    if not _G.SST or type(_G.SST.Place_WebHook_Link) ~= "string" or _G.SST.Place_WebHook_Link == "" then return false end
    if not HttpService then return false end

    local replicatedStorage = game:GetService("ReplicatedStorage")
    local pd = replicatedStorage:FindFirstChild("Player_Data") and replicatedStorage.Player_Data:FindFirstChild(player.Name)
    if not pd or not pd:FindFirstChild("Data") then return false end

    local dataFolder = pd.Data
    local function safeVal(obj) return obj and tostring(obj.Value or obj.Text or "0") or "0" end

    local gemVal        = safeVal(dataFolder:FindFirstChild("Gem"))
    local goldVal       = safeVal(dataFolder:FindFirstChild("Gold"))
    local RCellVal      = safeVal(dataFolder:FindFirstChild("RCCells"))
    local SolTokenVal   = safeVal(dataFolder:FindFirstChild("Sol Token"))
    local EsperTokenVal = safeVal(dataFolder:FindFirstChild("Esper Token"))
    local CurseTokenVal = safeVal(dataFolder:FindFirstChild("CurseToken"))
    local BossCoinsVal  = safeVal(dataFolder:FindFirstChild("Boss Coin"))
    local levelVal      = safeVal(dataFolder:FindFirstChild("Level"))
    local expVal        = safeVal(dataFolder:FindFirstChild("Exp"))

    local itemsFolder = pd:FindFirstChild("Items")
    local resourcesValues = {}
    if itemsFolder then
        for _, child in pairs(itemsFolder:GetChildren()) do
            if child:IsA("Folder") then
                local amountObj = child:FindFirstChild("Amount")
                if amountObj then
                    resourcesValues[child.Name] = tostring(amountObj.Value)
                end
            end
        end
    end

    if type(_G.SST.WH_Resources_Fields) ~= "table" or next(_G.SST.WH_Resources_Fields) == nil then
        _G.SST.WH_Resources_Fields = {}
        for name, _ in pairs(resourcesValues) do
            _G.SST.WH_Resources_Fields[name] = true
        end
    end

    local preset   = WH_COLOR_PRESETS[_G.SST.WH_Color_Preset or "Green / Red"] or WH_COLOR_PRESETS["Green / Red"]
    local colorInt = isWin and preset.win or preset.lose

    local ei = type(_G.SST.WH_Embed_Info)=="table" and _G.SST.WH_Embed_Info or {ResultEmoji=true, PlayerName=true}
    local descParts = {}
    if ei["Result Emoji"] or ei["ResultEmoji"] then
        if isWin then table.insert(descParts, "# 🏆  VICTORY\n> The battle is won. Rangers stand victorious!")
        else          table.insert(descParts, "# 💀  DEFEAT\n> The battle is lost. Try again, Ranger.") end
    end
    if ei["Player Name"] or ei["PlayerName"] then
        table.insert(descParts, "> 👤  **"..player.Name.."**") end
    if ei["Match Time"] or ei["MatchTime"] then
        table.insert(descParts, "> ⏱️  Match Time : **"..tostring(GameTime).."**") end
    if ei["Rewards Summary"] or ei["RewardsSummary"] then
        local short = RewardsText ~= "" and RewardsText:gsub("\n"," | "):gsub(" | $","") or "— none —"
        table.insert(descParts, "> 🎁  "..short) end
    local embedDesc = #descParts > 0 and table.concat(descParts,"\n") or (isWin and "# 🏆  VICTORY" or "# 💀  DEFEAT")

    local currencyFields  = type(_G.SST.WH_Currency_Fields)=="table" and _G.SST.WH_Currency_Fields
                            or {Gold=true, Gem=true, RCCells=true, ["Sol Token"]=true, ["Esper Token"]=true, ["Curse Token"]=true, ["Boss Coin"]=true}
    local resourcesFields = type(_G.SST.WH_Resources_Fields)=="table" and _G.SST.WH_Resources_Fields or {}

    local function fmtRow(label, value)
        return string.format("%-20s : %s", label, value)
    end

    local fields = {}

    local infoLines = {
        fmtRow("Player", player.Name),
        fmtRow("Level",  levelVal),
        fmtRow("EXP",    expVal),
    }
    table.insert(fields, {["name"]="📋 Info", ["value"]="```\n"..table.concat(infoLines,"\n").."\n```", ["inline"]=false})

    local currencyOrder = {"Gold","Gem","RCCells","Sol Token","Esper Token","Curse Token","Boss Coin"}
    local currencyLines = {}
    for _, item in ipairs(currencyOrder) do
        if currencyFields[item] then
            local value = item=="Gold" and goldVal or item=="Gem" and gemVal or item=="RCCells" and RCellVal
                       or item=="Sol Token" and SolTokenVal or item=="Esper Token" and EsperTokenVal
                       or item=="Curse Token" and CurseTokenVal or item=="Boss Coin" and BossCoinsVal or "0"
            table.insert(currencyLines, fmtRow(item, value))
        end
    end
    if #currencyLines > 0 then
        table.insert(fields, {["name"]="💰 Currency", ["value"]="```\n"..table.concat(currencyLines,"\n").."\n```", ["inline"]=false})
    end

    local sortedRes = {}
    for resName, resAmount in pairs(resourcesValues) do
        if resourcesFields[resName] then
            table.insert(sortedRes, {name=resName, amount=resAmount})
        end
    end
    table.sort(sortedRes, function(a,b) return a.name < b.name end)
    local resourceLines = {}
    for _, r in ipairs(sortedRes) do
        table.insert(resourceLines, fmtRow(r.name, r.amount))
    end
    if #resourceLines > 0 then
        table.insert(fields, {["name"]="📦 Resources", ["value"]="```\n"..table.concat(resourceLines,"\n").."\n```", ["inline"]=false})
    end

    if _G.SST.WH_Show_Time == true then
        table.insert(fields, {["name"]="⏱️ Match Time", ["value"]="```\n"..fmtRow("Match Time", tostring(GameTime)).."\n```", ["inline"]=false})
    end

    if _G.SST.WH_Show_Rewards == true then
        local rewardsDisplay = (RewardsText ~= "" and RewardsText) or "— none —"
        table.insert(fields, {["name"]="🎁 Rewards", ["value"]="```\n"..rewardsDisplay.."\n```", ["inline"]=false})
    end

    local fi = type(_G.SST.WH_Footer_Info)=="table" and _G.SST.WH_Footer_Info or {HubName=true}
    local footerParts = {}
    if fi["Hub Name"]    or fi["HubName"]    then table.insert(footerParts, "Anitary Hub") end
    if fi["Player Name"] or fi["PlayerName"] then table.insert(footerParts, player.Name) end
    if fi["Result"]      or fi["result"]     then table.insert(footerParts, isWin and "Victory" or "Defeat") end
    local footerText = #footerParts > 0 and table.concat(footerParts," | ") or "Anitary Hub"

    local pingType = _G.SST.WH_Ping_Type or "None"
    local contentStr = ""
    if pingType == "@everyone" then contentStr = "@everyone"
    elseif pingType == "@here" then contentStr = "@here"
    elseif pingType == "Role ID" then
        local rid = _G.SST.WH_Role_ID or ""
        if rid ~= "" then contentStr = "<@&"..rid..">" end
    end

    local avatarUrl = getAvatar(player.UserId)
    local payload = {
        ["content"] = contentStr,
        ["embeds"]  = {{
            ["author"]      = {["name"]="👤  "..player.Name, ["icon_url"]=avatarUrl, ["url"]="https://www.roblox.com/users/"..player.UserId.."/profile"},
            ["title"]       = "Anime Rangers X  ·  Match Result",
            ["description"] = embedDesc,
            ["thumbnail"]   = {["url"]=avatarUrl},
            ["color"]       = colorInt,
            ["fields"]      = fields,
            ["timestamp"]   = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
            ["footer"]      = {["text"]=footerText, ["icon_url"]=avatarUrl},
        }}
    }

    local ok2, json = pcall(function() return HttpService:JSONEncode(payload) end)
    if not ok2 then return false end

    local req = http_request or request or (syn and syn.request)
    if type(req) ~= "function" then return false end

    local success, res = pcall(function()
        return req({Url=_G.SST.Place_WebHook_Link, Method="POST", Headers={["Content-Type"]="application/json"}, Body=json})
    end)
    if not success then return false end
    return true
end

