        onThemeChange("CardRadius",function(r) if fc and fc.Parent then fc.CornerRadius=UDim.new(0,r) end end)
        onThemeChange("CardStroke",function(c) if sk and sk.Parent then sk.Color=c end end)
        return f
    end

    local function mkTxt(parent,txt,x,sz)
        local l=Instance.new("TextLabel",parent); l.BackgroundTransparency=1
        l.Position=UDim2.new(0,x or 8,0,0); l.Size=UDim2.new(1,-(x or 8)-4,1,0)
        l.Font=Enum.Font.Gotham; l.Text=txt; l.TextColor3=Theme.Text; l.TextSize=sz or 12
        l.TextXAlignment=Enum.TextXAlignment.Left
        onThemeChange("Text",function(c) if l and l.Parent then l.TextColor3=c end end)
        return l
    end

    local function mkButton(parent,txt,cb)
        local f=mkCard(parent,34)
        local b=Instance.new("TextButton",f); b.BackgroundTransparency=1; b.Size=UDim2.new(1,0,1,0)
        b.Font=Enum.Font.GothamSemibold; b.Text=txt; b.TextColor3=Theme.Accent; b.TextSize=12; b.AutoButtonColor=false
        onThemeChange("Accent",function(c) if b and b.Parent then b.TextColor3=c end end)
        b.MouseButton1Click:Connect(function() pcall(cb) end)
        b.MouseEnter:Connect(function() TweenService:Create(f,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(40,40,40)}):Play() end)
        b.MouseLeave:Connect(function() TweenService:Create(f,TweenInfo.new(0.15),{BackgroundColor3=Theme.CardBg}):Play() end)
    end
    function tab:AddButtonL(t,cb) mkButton(lPage,t,cb) end
    function tab:AddButtonR(t,cb) mkButton(rPage,t,cb) end

    local function mkToggle(parent,txt,def,cb)
        local f=mkCard(parent,34); mkTxt(f,txt); local on=def==true
        local pill=Instance.new("TextButton",f)
        pill.AnchorPoint=Vector2.new(1,0.5); pill.Position=UDim2.new(1,-8,0.5,0); pill.Size=UDim2.new(0,38,0,20)
        pill.BackgroundColor3=on and Theme.Accent or Color3.fromRGB(55,55,55); pill.BorderSizePixel=0; pill.Text=""; pill.AutoButtonColor=false
        Instance.new("UICorner",pill).CornerRadius=UDim.new(0,10)
        local knob=Instance.new("Frame",pill); knob.AnchorPoint=Vector2.new(0.5,0.5)
        knob.Position=on and UDim2.new(1,-10,0.5,0) or UDim2.new(0,10,0.5,0)
        knob.Size=UDim2.new(0,14,0,14); knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0
        Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
        onThemeChange("Accent",function(c) if on and pill and pill.Parent then pill.BackgroundColor3=c end end)
        local function toggle()
            on=not on
            TweenService:Create(pill,TweenInfo.new(0.2),{BackgroundColor3=on and Theme.Accent or Color3.fromRGB(55,55,55)}):Play()
            TweenService:Create(knob,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
                {Position=on and UDim2.new(1,-10,0.5,0) or UDim2.new(0,10,0.5,0)}):Play()
            pcall(cb,on)
        end
