task.spawn(function()
    local gui=plr:WaitForChild("PlayerGui")
    local remF=ReplicatedStorage:WaitForChild("Remote",9e9):WaitForChild("Server",9e9)
    local votePath=remF:WaitForChild("OnGame",9e9):WaitForChild("Voting",9e9)
    local upgradeRemote=remF:WaitForChild("Units",9e9):WaitForChild("Upgrade",9e9)
    local statsRemote=remF:WaitForChild("Gameplay",9e9):WaitForChild("StatsManager",9e9)
    local votePlayingRemote=votePath:WaitForChild("VotePlaying",9e9)
    local hud=gui:WaitForChild("HUD",9e9)
    local inGameUI=hud and hud:WaitForChild("InGame",9e9)
    local votePlayingUI=inGameUI and inGameUI:WaitForChild("VotePlaying",9e9)
    local unitsF=plr:WaitForChild("UnitsFolder",9e9)
    local vim2=game:GetService("VirtualInputManager")

    while task.wait(0.05) do
        local sst=_G.SST; if type(sst)~="table" then task.wait(1); continue end

        -- Auto Vote
        if sst.Auto_Vote and type(sst.Select_Vote)=="table" then
            pcall(function()
                local visual=workspace:FindFirstChild("Visual"); if not visual then return end
                local rewardsUI=gui:FindFirstChild("RewardsUI"); if not rewardsUI or not rewardsUI.Enabled then return end
                local main=rewardsUI:FindFirstChild("Main"); if not main then return end
                local leftSide=main:FindFirstChild("LeftSide"); if not leftSide then return end
                local RWBT=leftSide:FindFirstChild("Button"); if not RWBT then return end
                local votes={}; for k,v in pairs(sst.Select_Vote) do if v then table.insert(votes,k) end end
                if #votes==0 then return end
                local voteRemote=votePath:FindFirstChild(votes[math.random(1,#votes)]); if not voteRemote then return end
                local hasModel=false
                for _,child in ipairs(visual:GetChildren()) do
                    if child:IsA("Model") then hasModel=true; vim2:SendMouseButtonEvent(100,200,0,true,game,0); vim2:SendMouseButtonEvent(100,200,0,false,game,0) end
                end
                if not hasModel then
                    local retryV=RWBT:FindFirstChild("Retry"); local nextV=RWBT:FindFirstChild("Next"); local leaveV=RWBT:FindFirstChild("Leave")
                    if (retryV and retryV.Visible) or (nextV and nextV.Visible) then voteRemote:FireServer()
                    elseif leaveV and leaveV.Visible and (not retryV or not retryV.Visible) and sst.Select_Vote["VoteLeave"] then TeleportService:Teleport(111446873000464) end
                end
            end)
        end

        -- Auto Upgrade
  -- Auto Upgrade (ตรวจสอบ Yen)
if sst.Auto_Upgrade and sst.Select_Unit and unitsF then
    pcall(function()
        -- ดึงค่า Yen ปัจจุบันจาก UI
        local yenValue = 0
        local hud = plr.PlayerGui:FindFirstChild("HUD")
        if hud then
            local inGame = hud:FindFirstChild("InGame")
            if inGame then
                local main = inGame:FindFirstChild("Main")
                if main then
                    local stats = main:FindFirstChild("Stats")
                    if stats then
                        local yenFrame = stats:FindFirstChild("Yen")
                        if yenFrame then
                            local yenValObj = yenFrame:FindFirstChild("YenValue")
                            if yenValObj then
                                yenValue = tonumber(yenValObj.Value) or 0
                            end
                        end
                    end
                end
            end
        end

        local selU = sst.Select_Unit
        local allU = false
        if type(selU) == "table" then
            if selU["All Unit"] then allU = true end
        else
            selU = {} -- fallback
        end

        for _, unit in ipairs(unitsF:GetChildren()) do
            if unit:IsA("Instance") and (allU or selU[unit.Name] == true) then
                -- หาค่า Cost จาก UI
                local cost = 0
                local unitsManager = plr.PlayerGui.HUD.InGame.UnitsManager
                if unitsManager then
                    local mainFrame = unitsManager.Main.Main.ScrollingFrame
                    if mainFrame then
                        local unitFrame = mainFrame:FindFirstChild(unit.Name)
                        if unitFrame then
                            local costTextObj = unitFrame:FindFirstChild("CostText")
                            if costTextObj then
                                local costText = costTextObj.Text
                                -- ดึงตัวเลขจากข้อความ เช่น "Cost: <font color='#ff0000'>250</font>"
                                cost = tonumber(costText:match("Cost:</font>%s*(%d+)")) or 0
                            end
                        end
                    end
                end

                -- ตรวจสอบว่ามีเงินพอหรือไม่
                if yenValue >= cost then
                    pcall(function()
                        upgradeRemote:FireServer(unit)
                        task.wait(0.2)
                    end)
                end
            end
        end
    end)
end

        -- Auto Upgrade Yen
        if sst.Auto_Upgtade_Maxyen then pcall(function() statsRemote:FireServer("MaximumYen") end) end

        -- Auto Vote Start
        if sst.Auto_Vote_Start and votePlayingUI and votePlayingUI.Visible then
            task.wait(sst.Select_Deley_Vote or 1)
            pcall(function() votePlayingRemote:FireServer() end)
        end
    end
end)

