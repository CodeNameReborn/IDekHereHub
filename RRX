-- ══════════════════════════════════════════════════════
--  NOTIFICATION SYSTEM
-- ══════════════════════════════════════════════════════
local NotifLog={}; local NotifLogCBs={}
local function onNotifLog(fn) table.insert(NotifLogCBs,fn) end
local function pushLog(txt)
    table.insert(NotifLog,1,{txt=txt,time=os.clock()})
    if #NotifLog>50 then table.remove(NotifLog) end
    for _,fn in ipairs(NotifLogCBs) do pcall(fn) end
end
local NQ={}; local NQ_GAP=8; local NQ_H=88; local NQ_W=320
local function nqRestack()
    for i,e in ipairs(NQ) do
        local off=0; for j=i+1,#NQ do off=off+NQ[j].h+NQ_GAP end
        TweenService:Create(e.frame,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Position=UDim2.new(0.5,0,1,-(16+off))}):Play()
    end
end
local function AddNotification(txt)
    pushLog(txt)
    -- ── island notification (drops below the pill) ──────
