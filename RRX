-- ── Trait Reroll loop ────────────────────────────────
task.spawn(function()
    local traitRemote
    pcall(function() traitRemote = ReplicatedStorage.Remote.Server.Gambling.RerollTrait end)
    local lastTrait    = ""
    local lastUnitName = ""
    while task.wait(0.5) do
        pcall(function()
            if not _G.SST.Auto_Reroll_Trait or not traitRemote then return end
            local unit = GetUnitPlayer:FindFirstChild(_G.SST.Select_UnitTrait)
            if not unit or not unit:FindFirstChild("Tag") then return end
            local desired = _G.SST.Select_Trait or {}
            local current = unit.PrimaryTrait.Value
            local secondTrait = unit.SecondaryTrait.Value
            -- reset เมื่อเปลี่ยน unit
            if lastUnitName ~= unit.Name then
                lastUnitName = unit.Name
                lastTrait    = ""
            end
            -- ตรวจว่าเลือก trait ไว้ไหม
            local hasDesired = false
            for _, v in pairs(desired) do if v then hasDesired=true; break end end
            if not hasDesired then return end

            if desired[current] or desired[secondTrait] then
                -- ได้ trait ที่ต้องการ → แจ้งเตือนครั้งเดียวแล้วหยุด
                if lastTrait ~= current and lastSecondTrait ~= secondTrait then
                    lastTrait = current
                    lastSecondTrait = secondTrait
                    AddNotification("[Trait] Got: "..current.."[SubTrait] Got: "  ..secondTrait.." on "..unit.Name.."!")
                    -- ส่ง Webhook ถ้าเปิด Send_WebHook อยู่
                    if _G.SST.Send_WebHook and _G.SST.Place_WebHook_Link ~= "" then
                        local url      = _G.SST.Place_WebHook_Link
                        -- getAvatar มี cache อยู่แล้ว → ได้ CDN URL จริง ไม่ใช่ redirect
                        local avatarUrl = getAvatar(plr.UserId)
                        local tag = unit:FindFirstChild("Tag") and unit.Tag.Value or "?"
                        local spd = unit:FindFirstChild("SpeedPotential") and unit.SpeedPotential.Value or "?"
                        local rng = unit:FindFirstChild("RangePotential") and unit.RangePotential.Value or "?"
                        local hp  = unit:FindFirstChild("HealthPotential") and unit.HealthPotential.Value or "?"
                        local dmg = unit:FindFirstChild("DamagePotential") and unit.DamagePotential.Value or "?"
                        local cd  = unit:FindFirstChild("AttackCooldownPotential") and unit.AttackCooldownPotential.Value or "?"
                        local payload = {
                            ["content"] = "",
                            ["embeds"] = {{
                                ["author"]      = { ["name"]="👤  "..plr.Name, ["icon_url"]=avatarUrl, ["url"]="https://www.roblox.com/users/"..plr.UserId.."/profile" },
                                ["title"]       = "Anime Rangers X  ·  Trait Reroll",
                                ["description"] = "# ✨  TRAIT UNLOCKED!\n> **"..unit.Name.."** got the desired trait.",
                                ["thumbnail"]   = { ["url"]=avatarUrl },
                                ["color"]       = 0xA855F7,
                                ["fields"] = {
                                    { ["name"]="✨  Trait",     ["value"]="```fix\n"..current.."\n```",  ["inline"]=false },
                                    { ["name"]="✨  SubTrait",  ["value"]="```fix\n"..secondTrait.."\n```",  ["inline"]=false },
                                    { ["name"]="🪪  Unit",       ["value"]="```fix\n"..unit.Name.."\n```", ["inline"]=true  },
                                    { ["name"]="🔑  Tag",        ["value"]="```fix\n"..tag.."\n```",       ["inline"]=true  },
                                    { ["name"]="📊  Potentials", ["value"]="```fix\nSpeed: "..spd.."  Range: "..rng.."\nHP:    "..hp.."   DMG:   "..dmg.."\nCD:    "..cd.."\n```", ["inline"]=false },
                                },
                                ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
                                ["footer"]    = { ["text"]="Anitary Hub    |  Trait Reroll", ["icon_url"]=avatarUrl },
                            }}
                        }
                        local ok, json = pcall(function() return HttpService:JSONEncode(payload) end)
                        if ok then
                            local req = http_request or request or (syn and syn.request)
                            if req then
                                pcall(function() req({ Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=json }) end)
                            end
                        end
                    end
                    -- หยุด reroll หลัง success เสมอ
                    _G.SST.Auto_Reroll_Trait = false
                    SS()
                end
            else
                -- ยังไม่ได้ → reroll ต่อ
                lastTrait = "" ..current
                lastSecondTrait = "" ..secondTrait  
                traitRemote:FireServer(unit, "Reroll", "Main", "Shards", {current,secondTrait})
                task.wait(0.5)
            end
        end)
    end
end)


