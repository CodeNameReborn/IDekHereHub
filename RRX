local function LoadSetting()
    if not fileSupport then return end
    pcall(function()
        local f = "Anitary Hub ARX ["..plr.Name.."].json"
        if isfile(f) then
            local ok, d = pcall(HttpService.JSONDecode, HttpService, readfile(f))
            if ok and type(d)=="table" then
                for k,v in pairs(d) do _G.SST[k]=v end
            end
        end
    end)
end
