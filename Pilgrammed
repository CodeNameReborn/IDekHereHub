local fileSupport = (type(writefile)=="function" and type(readfile)=="function" and type(isfile)=="function")

-- Default settings (will be overwritten by LoadSetting if file exists)
_G.SST = {}

local function SS()
    if not fileSupport then return end
    pcall(function()
        writefile("Anitary Hub Pilgrammed ["..plr.Name.."].json",
            HttpService:JSONEncode(_G.SST))
    end)
end

local function LoadSetting()
    if not fileSupport then return end
    pcall(function()
        local f = "Anitary Hub Pilgrammed ["..plr.Name.."].json"
        if isfile(f) then
            local ok, d = pcall(HttpService.JSONDecode, HttpService, readfile(f))
            if ok and type(d)=="table" then
                for k,v in pairs(d) do _G.SST[k]=v end
            end
        end
    end)
end
