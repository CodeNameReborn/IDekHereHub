    function tab:AddSliderR(t,mn,mx,d,cb) mkSlider(rPage,t,mn,mx,d,cb) end

    -- ══ DROPDOWN (with Refresh button) ══════════════════
    local function mkDropdown(parent,title,list,def,cb)
        local IH=28; local CARD_H=52; local SB_Y=56; local SB_H=26; local ITEMS_Y=SB_Y+SB_H+4
        local open=false; local curList=list; local curSel=def or (list[1] or "Select..."); local iBtns={}
        local wrap=Instance.new("Frame",parent); wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,CARD_H); wrap.ClipsDescendants=false
        local base=mkCard(wrap,CARD_H); base.Size=UDim2.new(1,0,0,CARD_H); base.ClipsDescendants=false

        -- header (เว้นขวา 26px ให้ refresh btn)
        local hdr=Instance.new("TextButton",base); hdr.BackgroundTransparency=1
        hdr.Size=UDim2.new(1,-28,0,26); hdr.Text=""; hdr.ZIndex=2
        mkTxt(hdr,title,8,12)
        local arr=Instance.new("TextLabel",hdr); arr.BackgroundTransparency=1
        arr.AnchorPoint=Vector2.new(1,0.5); arr.Position=UDim2.new(1,-4,0.5,0)
        arr.Size=UDim2.new(0,14,0,14); arr.Font=Enum.Font.GothamBold
        arr.Text="▼"; arr.TextColor3=Theme.Accent; arr.TextSize=9
        onThemeChange("Accent",function(c) if arr and arr.Parent then arr.TextColor3=c end end)

        -- ── Refresh button ──
        local rBtn,spinFn=makeRefreshBtn(base,3)

        local sel=Instance.new("TextLabel",base); sel.BackgroundColor3=Color3.fromRGB(38,38,38); sel.BorderSizePixel=0
        sel.Position=UDim2.new(0,4,0,28); sel.Size=UDim2.new(1,-8,0,20)
        sel.Font=Enum.Font.Gotham; sel.Text=curSel; sel.TextColor3=Theme.Accent; sel.TextSize=11
        Instance.new("UICorner",sel).CornerRadius=UDim.new(0,4)
        onThemeChange("Accent",function(c) if sel and sel.Parent then sel.TextColor3=c end end)

        local sb=Instance.new("TextBox",wrap); sb.BackgroundColor3=Color3.fromRGB(35,35,35); sb.BorderSizePixel=0
        sb.Position=UDim2.new(0,0,0,SB_Y); sb.Size=UDim2.new(1,0,0,SB_H)
        sb.Font=Enum.Font.Gotham; sb.PlaceholderText=">> Search ..."; sb.PlaceholderColor3=Color3.fromRGB(90,90,90)
        sb.Text=""; sb.TextColor3=Color3.fromRGB(200,200,200); sb.TextSize=11; sb.ClearTextOnFocus=false
        sb.Visible=false; sb.ZIndex=3
        Instance.new("UICorner",sb).CornerRadius=UDim.new(0,5)
        Instance.new("UIStroke",sb).Color=Color3.fromRGB(50,50,50)

        local iFrame=Instance.new("Frame",wrap); iFrame.BackgroundTransparency=1
        iFrame.Position=UDim2.new(0,0,0,ITEMS_Y); iFrame.Size=UDim2.new(1,0,0,#curList*IH)
        iFrame.Visible=false; iFrame.ZIndex=3
        Instance.new("UIListLayout",iFrame).SortOrder=Enum.SortOrder.LayoutOrder

        local function calcOpenH(n) return ITEMS_Y+n*IH end
        local function closeDD()
            open=false; sb.Text=""; sb.Visible=false; iFrame.Visible=false
            for _,b in ipairs(iBtns) do if b and b.Parent then b.Visible=true end end
            wrap:TweenSize(UDim2.new(1,0,0,CARD_H),"Out","Quad",0.18,true)
            TweenService:Create(arr,TweenInfo.new(0.15),{Rotation=0}):Play()
        end
        local function buildItems(lst)
            for _,b in ipairs(iBtns) do if b and b.Parent then b:Destroy() end end
            iBtns={}; iFrame.Size=UDim2.new(1,0,0,#lst*IH)
            for _,item in ipairs(lst) do
                local ib=Instance.new("TextButton",iFrame); ib.BackgroundColor3=Color3.fromRGB(32,32,32)
                ib.BorderSizePixel=0; ib.Size=UDim2.new(1,0,0,IH); ib.Font=Enum.Font.Gotham
                ib.Text=item; ib.TextColor3=Color3.fromRGB(195,195,195); ib.TextSize=11; ib.AutoButtonColor=false
                ib.MouseEnter:Connect(function() TweenService:Create(ib,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(46,46,46)}):Play() end)
                ib.MouseLeave:Connect(function() TweenService:Create(ib,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(32,32,32)}):Play() end)
                local cap=item; ib.MouseButton1Click:Connect(function() curSel=cap; sel.Text=cap; pcall(cb,cap); closeDD() end)
                table.insert(iBtns,ib)
            end
        end
        buildItems(curList)

        sb:GetPropertyChangedSignal("Text"):Connect(function()
            local q=sb.Text:lower(); local vis=0
            for i,ib in ipairs(iBtns) do
                if ib and ib.Parent then
                    local show=q=="" or (curList[i] and curList[i]:lower():find(q,1,true)~=nil)
                    ib.Visible=show; if show then vis=vis+1 end
                end
            end
            if open then wrap:TweenSize(UDim2.new(1,0,0,calcOpenH(vis)),"Out","Quad",0.12,true) end
        end)

        local function toggleOpen()
            open=not open
            if open then
                sb.Visible=true; iFrame.Visible=true
                wrap:TweenSize(UDim2.new(1,0,0,calcOpenH(#curList)),"Out","Back",0.22,true)
                TweenService:Create(arr,TweenInfo.new(0.2),{Rotation=180}):Play()
            else closeDD() end
        end
        hdr.MouseButton1Click:Connect(toggleOpen)

        local obj={}
        function obj:Update(newList)
            closeDD(); curList=newList
            local found=false; for _,v in ipairs(newList) do if v==curSel then found=true; break end end
            if not found then curSel=newList[1] or "Select..."; sel.Text=curSel end
            buildItems(curList)
        end
        function obj:Set(v) curSel=v; sel.Text=v end
        function obj:Get() return curSel end

        -- ── ผูก Refresh ──
        rBtn.MouseButton1Click:Connect(function()
            task.spawn(spinFn)
            if obj.onRefresh then
                local ok,newList=pcall(obj.onRefresh)
                if ok and type(newList)=="table" then obj:Update(newList) end
            end
        end)

        return obj
    end
    function tab:AddDropdownL(t,l,d,cb) return mkDropdown(lPage,t,l,d,cb) end
    function tab:AddDropdownR(t,l,d,cb) return mkDropdown(rPage,t,l,d,cb) end

    -- ══ MULTI DROPDOWN (with Refresh button) ════════════
    local function mkMultiDropdown(parent,title,list,cb)
        local IH=30; local CARD_H=52; local SB_Y=56; local SB_H=26; local ITEMS_Y=SB_Y+SB_H+4
        local open=false; local selected={}; local curList=list; local rows={}
        local wrap=Instance.new("Frame",parent); wrap.BackgroundTransparency=1; wrap.Size=UDim2.new(1,0,0,CARD_H); wrap.ClipsDescendants=false
        local base=mkCard(wrap,CARD_H); base.Size=UDim2.new(1,0,0,CARD_H); base.ClipsDescendants=false

        local hdr=Instance.new("TextButton",base); hdr.BackgroundTransparency=1
        hdr.Size=UDim2.new(1,-28,0,26); hdr.Text=""; hdr.ZIndex=2
        mkTxt(hdr,""..title,8,12)
        local arr=Instance.new("TextLabel",hdr); arr.BackgroundTransparency=1
        arr.AnchorPoint=Vector2.new(1,0.5); arr.Position=UDim2.new(1,-4,0.5,0)
        arr.Size=UDim2.new(0,14,0,14); arr.Font=Enum.Font.GothamBold
        arr.Text="▼"; arr.TextColor3=Theme.Accent; arr.TextSize=9
        onThemeChange("Accent",function(c) if arr and arr.Parent then arr.TextColor3=c end end)

        -- ── Refresh button ──
        local rBtn,spinFn=makeRefreshBtn(base,3)

        local sel=Instance.new("TextLabel",base); sel.BackgroundColor3=Color3.fromRGB(38,38,38); sel.BorderSizePixel=0
        sel.Position=UDim2.new(0,4,0,28); sel.Size=UDim2.new(1,-8,0,20)
        sel.Font=Enum.Font.Gotham; sel.Text=" Select..."; sel.TextColor3=Color3.fromRGB(90,90,90); sel.TextSize=10
        Instance.new("UICorner",sel).CornerRadius=UDim.new(0,4)

        local sb=Instance.new("TextBox",wrap); sb.BackgroundColor3=Color3.fromRGB(35,35,35); sb.BorderSizePixel=0
        sb.Position=UDim2.new(0,0,0,SB_Y); sb.Size=UDim2.new(1,0,0,SB_H)
        sb.Font=Enum.Font.Gotham; sb.PlaceholderText=">> Search ..."; sb.PlaceholderColor3=Color3.fromRGB(90,90,90)
        sb.Text=""; sb.TextColor3=Color3.fromRGB(200,200,200); sb.TextSize=11; sb.ClearTextOnFocus=false
        sb.Visible=false; sb.ZIndex=3
        Instance.new("UICorner",sb).CornerRadius=UDim.new(0,5)
        Instance.new("UIStroke",sb).Color=Color3.fromRGB(50,50,50)

        local iFrame=Instance.new("Frame",wrap); iFrame.BackgroundTransparency=1
        iFrame.Position=UDim2.new(0,0,0,ITEMS_Y); iFrame.Size=UDim2.new(1,0,0,#list*IH)
        iFrame.Visible=false; iFrame.ZIndex=3
        Instance.new("UIListLayout",iFrame).SortOrder=Enum.SortOrder.LayoutOrder

        local function calcOpenH(n) return ITEMS_Y+n*IH end
        local function updSel()
            local k={}; for kk in pairs(selected) do table.insert(k,kk) end
            if #k==0 then sel.Text="Select multiple items..."; sel.TextColor3=Color3.fromRGB(90,90,90)
            else sel.Text=table.concat(k,", "); sel.TextColor3=Theme.Accent end
            pcall(cb,selected)
        end
        local function buildRows(lst)
            for _,rd in ipairs(rows) do if rd.row and rd.row.Parent then rd.row:Destroy() end end
            rows={}; iFrame.Size=UDim2.new(1,0,0,#lst*IH)
            for _,item in ipairs(lst) do
                local row=Instance.new("Frame",iFrame)
                row.BackgroundColor3=selected[item] and Color3.fromRGB(38,38,38) or Color3.fromRGB(30,30,30)
                row.BorderSizePixel=0; row.Size=UDim2.new(1,0,0,IH)
                local chk=Instance.new("Frame",row); chk.AnchorPoint=Vector2.new(0,0.5)
                chk.Position=UDim2.new(0,8,0.5,0); chk.Size=UDim2.new(0,14,0,14)
                chk.BackgroundColor3=selected[item] and Theme.Accent or Color3.fromRGB(50,50,50); chk.BorderSizePixel=0
                Instance.new("UICorner",chk).CornerRadius=UDim.new(0,4)
                local ct=Instance.new("TextLabel",chk); ct.Size=UDim2.new(1,0,1,0); ct.BackgroundTransparency=1
                ct.Text="✓"; ct.TextColor3=Color3.fromRGB(15,15,15); ct.Font=Enum.Font.GothamBold; ct.TextSize=10; ct.Visible=selected[item]==true
                local il=Instance.new("TextLabel",row); il.BackgroundTransparency=1
                il.Position=UDim2.new(0,28,0,0); il.Size=UDim2.new(1,-32,1,0)
                il.Font=Enum.Font.Gotham; il.Text=item; il.TextColor3=Color3.fromRGB(195,195,195); il.TextSize=11; il.TextXAlignment=Enum.TextXAlignment.Left
                local btn=Instance.new("TextButton",row); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
                local capI,capC,capCt,capR=item,chk,ct,row
                btn.MouseButton1Click:Connect(function()
                    if selected[capI] then
                        selected[capI]=nil
                        TweenService:Create(capC,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(50,50,50)}):Play(); capCt.Visible=false
                        TweenService:Create(capR,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(30,30,30)}):Play()
                    else
                        selected[capI]=true
                        TweenService:Create(capC,TweenInfo.new(0.15),{BackgroundColor3=Theme.Accent}):Play(); capCt.Visible=true
                        TweenService:Create(capR,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(38,38,38)}):Play()
                    end; updSel()
                end)
                table.insert(rows,{row=row,item=item})
            end
        end
        buildRows(curList)

        sb:GetPropertyChangedSignal("Text"):Connect(function()
            local q=sb.Text:lower(); local vis=0
            for _,d in ipairs(rows) do
                if d.row and d.row.Parent then
                    local show=q=="" or d.item:lower():find(q,1,true)~=nil
                    d.row.Visible=show; if show then vis=vis+1 end
                end
            end
            if open then wrap:TweenSize(UDim2.new(1,0,0,calcOpenH(vis)),"Out","Quad",0.12,true) end
        end)

        local function closeDD()
            open=false; sb.Text=""; sb.Visible=false; iFrame.Visible=false
            for _,d in ipairs(rows) do if d.row and d.row.Parent then d.row.Visible=true end end
            wrap:TweenSize(UDim2.new(1,0,0,CARD_H),"Out","Quad",0.18,true)
            TweenService:Create(arr,TweenInfo.new(0.15),{Rotation=0}):Play()
        end
        local function toggleOpen()
            open=not open
            if open then
                sb.Visible=true; iFrame.Visible=true
                wrap:TweenSize(UDim2.new(1,0,0,calcOpenH(#curList)),"Out","Back",0.22,true)
                TweenService:Create(arr,TweenInfo.new(0.2),{Rotation=180}):Play()
            else closeDD() end
        end
        hdr.MouseButton1Click:Connect(toggleOpen)

        local obj={}
        function obj:Update(newList)
            closeDD(); curList=newList
            local ns={}; for _,v in ipairs(newList) do ns[v]=true end
            for k in pairs(selected) do if not ns[k] then selected[k]=nil end end
            buildRows(curList); updSel()
        end
        function obj:Set(tbl) selected={}; for k,v in pairs(tbl) do if v then selected[k]=v end end; buildRows(curList); updSel() end
        function obj:Get() return selected end
        function obj:Clear() selected={}; buildRows(curList); updSel() end

        -- ── ผูก Refresh ──
        rBtn.MouseButton1Click:Connect(function()
            task.spawn(spinFn)
            if obj.onRefresh then
                local ok,newList=pcall(obj.onRefresh)
                if ok and type(newList)=="table" then obj:Update(newList) end
            end
        end)

        return obj
    end
    function tab:AddMultiDropdownL(t,l,cb) return mkMultiDropdown(lPage,t,l,cb) end
