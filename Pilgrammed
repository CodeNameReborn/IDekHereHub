--  FARM MOB LOOP
-- ══════════════════════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(0.15)
        if not _G.SST.Farm_Mob then task.wait(0.5) continue end

        local mobName = _G.SST.Select_Mob
        if not mobName or not Moblist[mobName] then task.wait(0.5) continue end

        local char = player.Character
        if not char then task.wait(0.5) continue end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then task.wait(0.5) continue end

        local mobData = Moblist[mobName]

        -- หา mob ที่ยังมีชีวิตอยู่ใกล้ที่สุด
        local nearestMob, nearestDist = nil, math.huge
        for _, folder in ipairs(mobData.Folders) do
            if not folder then continue end
            for _, model in ipairs(folder:GetChildren()) do
                local mHum = model:FindFirstChildOfClass("Humanoid")
                local mHRP = model:FindFirstChild("HumanoidRootPart")
                if mHum and mHRP and mHum.Health > 0 then
                    local d = (hrp.Position - mHRP.Position).Magnitude
                    if d < nearestDist then
                        nearestDist = d
                        nearestMob = model
                    end
                end
            end
        end

        if nearestMob then
            local mHRP = nearestMob:FindFirstChild("HumanoidRootPart")
            if mHRP then
                -- teleport ติดข้าง mob
                hrp.CFrame = mHRP.CFrame * CFrame.new(
                    _G.SST.Pos_X or 0,
                    _G.SST.Pos_Y or 2,
                    _G.SST.Pos_Z or 4
                )
                task.wait(0.08)

                -- equip + attack weapon
                local wName = _G.SST.Select_Weapon or ""
                local tool = player.Backpack:FindFirstChild(wName)
                    or char:FindFirstChild(wName)
                if tool and tool:IsA("Tool") then
                    if not char:FindFirstChild(wName) then
                        hum:EquipTool(tool)
                        task.wait(0.12)
                    end
                    local eq = char:FindFirstChild(wName)
                    if eq then pcall(function() eq:Activate() end) end
                end
            end
        else
            -- ไม่มี mob → teleport กลับไปที่ spawn
            hrp.CFrame = mobData.SpawnCFrame
            task.wait(1)
        end
    end
end)

