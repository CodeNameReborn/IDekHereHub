do
    local _blockConn = nil
    local _cooldown = false

    local function setupAutoBlock()
        if _blockConn then
            _blockConn:Disconnect()
            _blockConn = nil
        end

        local player = game:GetService("Players").LocalPlayer
        local char = player.Character or player.CharacterAdded:Wait()
        local human = char:WaitForChild("Humanoid")

        local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Block")

        local lastHP = human.Health

        _blockConn = human.HealthChanged:Connect(function(newHP)
            if not _G.SST.Auto_Block then return end
            if _cooldown then return end

            if newHP < lastHP then
                _cooldown = true

                remote:FireServer(true)
                remote:FireServer(false)

                -- cooldown กัน spam (สำคัญมาก)
                task.delay(0.15, function()
                    _cooldown = false
                end)
            end

            lastHP = newHP
        end)
    end

    -- Toggle trigger (เรียกแค่ตอนเปิด/ปิด)
    task.spawn(function()
        while true do
            if _G.SST.Auto_Block and not _blockConn then
                setupAutoBlock()
            elseif not _G.SST.Auto_Block and _blockConn then
                _blockConn:Disconnect()
                _blockConn = nil
            end
            task.wait(0.5) -- เช็คห่างๆพอ ไม่ต้องทุกเฟรม
        end
    end)

    -- Respawn support
    game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function()
        if _G.SST.Auto_Block then
            task.wait(0.5)
            setupAutoBlock()
        end
    end)
end

