local function setupDeathWebhook()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum  = char:WaitForChild("Humanoid")
    hum.Died:Connect(function()
        if not _G.SST.WH_Death then return end
        sendWebhook({
            username = "Anitary Hub",
            embeds = {{
                title       = "💀 ตายแล้ว!",
                description = "**" .. plr.Name .. "** ถูกสังหารใน Pilgrammed",
                color       = 0xff3333,
                footer      = { text = "Anitary Hub" },
                timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ")
            }}
        })
    end)
end
setupDeathWebhook()
player.CharacterAdded:Connect(function()
    task.wait(1)
    setupDeathWebhook()
end)

-- ── Auto Webhook: แจ้งเมื่อ Mob ตาย (Kill) ──────────
task.spawn(function()
    local tracked = {}
    while true do
        task.wait(0.5)
        if not _G.SST.WH_Kill or not _G.SST.Select_Mob then continue end
        local mobData = Moblist[_G.SST.Select_Mob]
        if not mobData then continue end
        for _, folder in ipairs(mobData.Folders) do
            if not folder then continue end
            for _, model in ipairs(folder:GetChildren()) do
                local mHum = model:FindFirstChildOfClass("Humanoid")
                if mHum and not tracked[model] then
                    tracked[model] = true
                    mHum.Died:Connect(function()
                        tracked[model] = nil
                        sendWebhook({
                            username = "Anitary Hub",
                            embeds = {{
                                title       = "⚔️ Kill!",
                                description = "สังหาร **" .. model.Name .. "** สำเร็จ!",
                                color       = 0x00ff99,
                                fields = {
                                    { name = "👤 Player", value = plr.Name, inline = true },
                                    { name = "🗡️ Mob",   value = _G.SST.Select_Mob or "?", inline = true },
                                },
                                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
                            }}
                        })
                    end)
                end
            end
        end
    end
end)
