local originalSettings = {
	saved = false,
	quality = nil,
	shadows = nil,
	fogEnd = nil,
	brightness = nil,
	effects = {},
	parts = {},
	decals = {},
	textures = {},
	particles = {},
	meshes = {}
}

function BoostFPS()
	local lighting = game:GetService("Lighting")

	if not originalSettings.saved then
		originalSettings.saved = true
		originalSettings.quality = settings().Rendering.QualityLevel
		originalSettings.shadows = lighting.GlobalShadows
		originalSettings.fogEnd = lighting.FogEnd
		originalSettings.brightness = lighting.Brightness

		-- Save post effects
		for _, v in pairs(lighting:GetChildren()) do
			if v:IsA("PostEffect") then
				originalSettings.effects[v] = v.Enabled
			end
		end

		-- Save individual objects
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				originalSettings.parts[v] = {
					Material = v.Material,
					Reflectance = v.Reflectance
				}
				v.Material = Enum.Material.SmoothPlastic
				v.Reflectance = 0

			elseif v:IsA("Decal") then
				originalSettings.decals[v] = v.Transparency
				v.Transparency = 1

			elseif v:IsA("Texture") then
				originalSettings.textures[v] = v.Transparency
				v.Transparency = 1

			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
				originalSettings.particles[v] = v.Enabled
				v.Enabled = false

			elseif v:IsA("MeshPart") then
				originalSettings.meshes[v] = {
					Material = v.Material,
					TextureID = v.TextureID
				}
				v.Material = Enum.Material.SmoothPlastic
				v.TextureID = ""
			end
		end
	end

	-- Apply low settings
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	lighting.GlobalShadows = false
	lighting.FogEnd = 100000
	lighting.Brightness = 1

	for effect in pairs(originalSettings.effects) do
		effect.Enabled = false
	end

	if workspace:FindFirstChildOfClass("Camera") then
		workspace.CurrentCamera:ClearAllChildren()
	end

	print("✅ Boost FPS: ON")
end

function ResetGraphics()
	if not originalSettings.saved then
		warn("⚠️ ยังไม่มีการ BoostFPS มาก่อน")
		return
	end

	local lighting = game:GetService("Lighting")
	settings().Rendering.QualityLevel = originalSettings.quality
	lighting.GlobalShadows = originalSettings.shadows
	lighting.FogEnd = originalSettings.fogEnd
	lighting.Brightness = originalSettings.brightness

	for effect, state in pairs(originalSettings.effects) do
		effect.Enabled = state
	end

	for obj, data in pairs(originalSettings.parts) do
		if obj and obj.Parent then
			obj.Material = data.Material
			obj.Reflectance = data.Reflectance
		end
	end

	for obj, transparency in pairs(originalSettings.decals) do
		if obj and obj.Parent then
			obj.Transparency = transparency
		end
	end

	for obj, transparency in pairs(originalSettings.textures) do
		if obj and obj.Parent then
			obj.Transparency = transparency
		end
	end

	for obj, enabled in pairs(originalSettings.particles) do
		if obj and obj.Parent then
			obj.Enabled = enabled
		end
	end

	for obj, data in pairs(originalSettings.meshes) do
		if obj and obj.Parent then
			obj.Material = data.Material
			obj.TextureID = data.TextureID
		end
	end

	print("✅ Boost FPS: OFF — กู้ค่ากราฟิกทั้งหมดแล้ว")
end


