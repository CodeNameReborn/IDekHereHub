   local currentTween = nil
local StopTweenFlag = false

function Tween(Pos)
    local player = game.Players.LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    local distance = (Pos.Position - hrp.Position).Magnitude

    -- ถ้านั่งอยู่ให้ยกเลิกการนั่ง
    if humanoid.Sit then
        humanoid.Sit = false
    end

    -- คำนวณเวลา Tween (ขั้นต่ำ 0.1 วินาที)
    local tweenTime = math.max(distance / _G.SST.Tween_Speed, 0.1)

    local success, err = pcall(function()
        currentTween = game:GetService("TweenService"):Create(
            hrp,
            TweenInfo.new(tweenTime, Enum.EasingStyle.Linear),
            {CFrame = Pos}
        )
    end)

    if success and currentTween then
        currentTween:Play()
    else
        warn("Tween creation failed:", err)
        return
    end

    -- ถ้าใกล้มากให้เทเลพอร์ตแทน
    if distance <= 200 then
        currentTween:Cancel()
        hrp.CFrame = Pos
    end

    -- หยุด Tween ถ้า flag เป็น true
    if StopTweenFlag then
        currentTween:Cancel()
        Clip = false
    end
end

