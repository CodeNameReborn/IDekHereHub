function StopTween(target)
    if not target then
        StopTweenFlag = true
        StopTweenFlagSit = true
        if currentTween then
            currentTween:Cancel()
        end
        if currentTweenSit then
            currentTweenSit:Cancel()
        end
        -- ลบ BodyClip ถ้ามี
        local hrp = game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("BodyClip") then
            hrp.BodyClip:Destroy()
        end
        StopTweenFlag = false
        StopTweenFlagSit = false
        Clip = false
        ClipSit = false
    end
