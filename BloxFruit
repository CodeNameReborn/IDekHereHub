    if not gui then return end
    if gui:FindFirstChild("RestoreButton") then return end

    -- เก็บค่าต้นฉบับ
    local originalSize = main.Size
    local originalPos = main.Position
    local originalTransparency = main.BackgroundTransparency

    -- จุด Dock (มุมล่างซ้าย)
    local dockPos = UDim2.new(0.01, 0, 0.01, 0)
    local dockSize = UDim2.new(0, 0, 0, 0)

    -- Tween ย่อแบบ spring
    local shrinkTween = TweenService:Create(main, TweenInfo.new(
        0.45,
        Enum.EasingStyle.Back, -- เด้งตอนย่อ
        Enum.EasingDirection.In
    ), {
        Size = dockSize,
        Position = dockPos,
        BackgroundTransparency = 1
    })

    shrinkTween:Play()
    shrinkTween.Completed:Once(function()
        main.Visible = false

        -- ปุ่ม Restore
        local restoreBtn = Instance.new("ImageButton")
        restoreBtn.Name = "RestoreButton"
        restoreBtn.Size = UDim2.new(0, 48, 0, 48)
        restoreBtn.Position = dockPos
        restoreBtn.BackgroundTransparency = 1
        restoreBtn.Image = "rbxassetid://108287073891881"
        restoreBtn.ScaleType = Enum.ScaleType.Fit
        restoreBtn.ZIndex = 9999
        restoreBtn.Draggable = true
        restoreBtn.Parent = gui

        local corner = Instance.new("UICorner", restoreBtn)
        corner.CornerRadius = UDim.new(0, 8)

        local stroke = Instance.new("UIStroke", restoreBtn)
        stroke.Thickness = 1
        stroke.Color = Color3.fromRGB(180, 180, 180)
        stroke.Transparency = 0.3

        -- ฟังก์ชัน Restore
        local function restore()
            main.Visible = true
            main.Size = dockSize
            main.Position = dockPos
            main.BackgroundTransparency = 1

            local expandTween = TweenService:Create(main, TweenInfo.new(
                0.5,
                Enum.EasingStyle.Back, -- เด้งตอนขยาย
                Enum.EasingDirection.Out
            ), {
                Size = originalSize,
                Position = originalPos,
                BackgroundTransparency = originalTransparency
            })

            expandTween:Play()
            expandTween.Completed:Once(function()
                restoreBtn:Destroy()
            end)
        end

        restoreBtn.MouseButton1Click:Connect(restore)

        -- Keybind Restore (RightControl)
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.KeyCode == Enum.KeyCode.RightControl then
                restore()
            end
        end)
    end)
end)

